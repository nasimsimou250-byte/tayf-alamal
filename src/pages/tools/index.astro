---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'الأدوات التعليمية';
const description = 'أدوات تعليمية مجانية لأطفال طيف التوحد — جداول بصرية، بطاقات تعليمية، وقصص اجتماعية باللغة العربية.';

const tools = [
  {
    id: 'visual-schedule',
    emoji: '🗓️',
    title: 'قوالب الجدول البصري',
    subtitle: 'Visual Schedule Templates',
    description: 'جداول بصرية جاهزة للطباعة تُساعد طفلك على فهم تسلسل أنشطة يومه بوضوح. تتضمن أيقونات ملوّنة وصور توضيحية لكل نشاط رئيسي.',
    longDescription: 'الجدول البصري أداة أساسية لأطفال طيف التوحد؛ إذ يُحوّل الوقت المجرد إلى تسلسل مرئي ملموس. مجموعتنا تشمل جداول الصباح، وجداول المدرسة، وجداول ما بعد الظهر، وجداول نهاية الأسبوع — كلها بتصميم عربي RTL.',
    forWho: 'مناسب لجميع مستويات الطيف (3 — 12 سنة)',
    category: 'تنظيم وروتين',
    categoryColor: '#3182ce',
    fileCount: '8 قوالب',
    format: 'PDF + PNG',
    featured: true,
  },
  {
    id: 'flashcards',
    emoji: '🃏',
    title: 'بطاقات تعليمية تواصلية',
    subtitle: 'Communication Flashcard Sets',
    description: 'مجموعات بطاقات تعليمية شاملة تغطي: المشاعر، الأطعمة، الألوان، الحيوانات، الملابس، وأفراد الأسرة — بصور واضحة وكلمات عربية.',
    longDescription: 'البطاقات التعليمية تُعزز المفردات اللغوية وتدعم التواصل التعبيري لأطفال الطيف. كل مجموعة مُصمَّمة باتساق بصري عالٍ لتقليل التشويش وتسهيل التعلم.',
    forWho: 'الأطفال من 2 — 8 سنوات والمبتدئون في التواصل',
    category: 'تواصل ولغة',
    categoryColor: '#38a169',
    fileCount: '120 بطاقة',
    format: 'PDF (مُحسَّن للطباعة)',
    featured: true,
  },
  {
    id: 'social-stories',
    emoji: '📖',
    title: 'قوالب القصص الاجتماعية',
    subtitle: 'Social Story Templates',
    description: 'قوالب جاهزة لكتابة قصص اجتماعية مخصصة لطفلك، تغطي مواقف مثل: الذهاب إلى الطبيب، دخول الفصل، تغيير الروتين، ولعب مع الأصدقاء.',
    longDescription: 'القصص الاجتماعية أسلوب تعليمي ابتكره Carol Gray وأثبتت أبحاث كثيرة فعاليته. قوالبنا تُمكّنك من تخصيص قصة لأي موقف يجده طفلك صعباً، مع إرشادات واضحة لكيفية الكتابة والاستخدام.',
    forWho: 'الأطفال من 4 — 14 سنة (مستوى 1 و2)',
    category: 'مهارات اجتماعية',
    categoryColor: '#805ad5',
    fileCount: '15 قالب',
    format: 'Word + PDF',
    featured: false,
  },
  {
    id: 'communication-boards',
    emoji: '🖼️',
    title: 'لوحات التواصل البديلة',
    subtitle: 'AAC Communication Boards',
    description: 'لوحات تواصل بصرية (AAC) للأطفال الذين يجدون صعوبة في التعبير اللفظي. تشمل لوحة الاحتياجات الأساسية، المشاعر، والأماكن الشائعة.',
    longDescription: 'التواصل المعزز والبديل (AAC) يُعطي الطفل صوتاً حين يتعذر التعبير اللفظي. لوحاتنا مُصمَّمة وفق مبادئ التصميم الواضح باستخدام رموز PECS مُعربة ومُصوَّرة.',
    forWho: 'الأطفال ذوو التواصل المحدود أو المنعدم (جميع الأعمار)',
    category: 'تواصل ولغة',
    categoryColor: '#38a169',
    fileCount: '6 لوحات',
    format: 'PDF (A4 + A3)',
    featured: false,
  },
  {
    id: 'daily-routine-charts',
    emoji: '⏰',
    title: 'جداول الروتين اليومي',
    subtitle: 'Daily Routine Charts',
    description: 'جداول تفصيلية لروتين الصباح والمساء ووقت النوم تُساعد طفلك على بناء استقلالية في اتباع روتينه اليومي خطوة بخطوة.',
    longDescription: 'الروتين المنظّم يُقلّل القلق ويُحسّن السلوك لأطفال الطيف. جداولنا تستخدم نظام "أولاً — ثم" لتقسيم المهام الكبيرة إلى خطوات صغيرة قابلة للتنفيذ، مع مساحة لعلامة الإنجاز.',
    forWho: 'الأطفال من 3 — 10 سنوات في جميع مستويات الطيف',
    category: 'تنظيم وروتين',
    categoryColor: '#3182ce',
    fileCount: '10 جداول',
    format: 'PDF + صور PNG',
    featured: true,
  },
];
---

<BaseLayout title={title} description={description}>

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="badge">أدوات مجانية</span>
      <h1 class="page-hero__title">الأدوات التعليمية</h1>
      <p class="page-hero__lead">
        مجموعة من الأدوات العملية المجانية المُصمَّمة خصيصاً لدعم أطفال طيف التوحد
        وتمكين آبائهم من تطبيق استراتيجيات التعليم في المنزل.
      </p>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat__num">{tools.length}</span>
          <span class="stat__label">أدوات متاحة</span>
        </div>
        <div class="stat">
          <span class="stat__num">159+</span>
          <span class="stat__label">ملف قابل للتنزيل</span>
        </div>
        <div class="stat">
          <span class="stat__num">100%</span>
          <span class="stat__label">مجانية</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro Note -->
  <section class="intro-note-section">
    <div class="container--narrow">
      <div class="intro-note">
        <span class="intro-note__icon">💡</span>
        <div>
          <strong>كيف تستخدم هذه الأدوات؟</strong>
          <p>
            كل الأدوات المتاحة هنا للاستخدام الشخصي والتعليمي المنزلي. نوصي باستشارة
            أخصائي التربية الخاصة أو معالج السلوك لاختيار الأداة المناسبة لطفلك وتكييفها
            مع احتياجاته الفردية.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ad Slot Top -->
  <div class="container">
    <div class="ad-slot">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="2233445566"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>
  </div>

  <!-- Featured Tools -->
  <section class="tools-section">
    <div class="container">
      <div class="section-header">
        <span class="badge">الأكثر استخداماً</span>
        <h2 class="section-title">الأدوات المميزة</h2>
        <p class="section-sub">هذه الأدوات هي الأكثر فائدة وفق آراء الآباء الذين يستخدمونها</p>
      </div>

      <div class="tools-featured-grid">
        {tools.filter(t => t.featured).map((tool) => (
          <div class="tool-card tool-card--featured">
            <div class="tool-card__header">
              <div class="tool-card__emoji">{tool.emoji}</div>
              <div class="tool-card__cat" style={`background: ${tool.categoryColor}15; color: ${tool.categoryColor};`}>
                {tool.category}
              </div>
            </div>
            <h3 class="tool-card__title">{tool.title}</h3>
            <p class="tool-card__subtitle">{tool.subtitle}</p>
            <p class="tool-card__desc">{tool.description}</p>
            <p class="tool-card__long">{tool.longDescription}</p>
            <div class="tool-card__info">
              <div class="tool-info-item">
                <span class="tool-info-icon">👦</span>
                <span>{tool.forWho}</span>
              </div>
              <div class="tool-info-item">
                <span class="tool-info-icon">📁</span>
                <span>{tool.fileCount} — {tool.format}</span>
              </div>
            </div>
            <a href={`/tools/${tool.id}/`} class="btn btn--primary tool-card__btn">
              ⬇️ عرض وطباعة الأداة (PDF)
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ad Slot Mid -->
  <div class="container">
    <div class="ad-slot">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="6655443322"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>
  </div>

  <!-- All Tools List -->
  <section class="tools-section">
    <div class="container">
      <div class="section-header">
        <span class="badge">المجموعة الكاملة</span>
        <h2 class="section-title">جميع الأدوات</h2>
        <p class="section-sub">استعرض كامل مجموعة أدواتنا التعليمية المجانية</p>
      </div>

      <div class="tools-list">
        {tools.map((tool) => (
          <div class="tool-list-item">
            <div class="tool-list-item__emoji">{tool.emoji}</div>
            <div class="tool-list-item__body">
              <div class="tool-list-item__top">
                <div>
                  <h3 class="tool-list-item__title">{tool.title}</h3>
                  <span class="tool-list-item__cat" style={`background: ${tool.categoryColor}15; color: ${tool.categoryColor};`}>
                    {tool.category}
                  </span>
                </div>
                <a href={`/tools/${tool.id}/`} class="btn btn--outline tool-list-item__btn">
                  عرض وطباعة ⬇️
                </a>
              </div>
              <p class="tool-list-item__desc">{tool.description}</p>
              <div class="tool-list-item__meta">
                <span>👦 {tool.forWho}</span>
                <span>📁 {tool.fileCount}</span>
                <span>📄 {tool.format}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ad Slot Third -->
  <div class="container">
    <div class="ad-slot">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="1122334466"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>
  </div>

  <!-- How to Use Section -->
  <section class="how-to-section">
    <div class="container--narrow">
      <span class="badge">دليل الاستخدام</span>
      <h2 class="section-title">كيف تبدأ باستخدام الأدوات؟</h2>
      <div class="steps-list">
        <div class="step">
          <div class="step__num">1</div>
          <div class="step__content">
            <h3>اختر الأداة المناسبة</h3>
            <p>ابدأ بتحديد التحدي الذي يواجهه طفلك حالياً — هل هو الروتين؟ التواصل؟ المهارات الاجتماعية؟ اختر الأداة التي تُعالج هذا التحدي أولاً.</p>
          </div>
        </div>
        <div class="step">
          <div class="step__num">2</div>
          <div class="step__content">
            <h3>اطبع وجهّز</h3>
            <p>قم بتحميل الأداة وطباعتها. نوصي بالطباعة على ورق مقوّى أو تغليف الأوراق للحصول على متانة أفضل في الاستخدام اليومي.</p>
          </div>
        </div>
        <div class="step">
          <div class="step__num">3</div>
          <div class="step__content">
            <h3>اقرأ التعليمات</h3>
            <p>كل أداة تأتي مع ملف تعليمات مُرفق يشرح كيفية الاستخدام الصحيح وكيف تُدخلها تدريجياً في روتين طفلك.</p>
          </div>
        </div>
        <div class="step">
          <div class="step__num">4</div>
          <div class="step__content">
            <h3>كيّفها لطفلك</h3>
            <p>كل طفل فريد. لا تتردد في تعديل الأداة لتناسب مستوى طفلك واهتماماته. القوالب القابلة للتحرير تُتيح لك ذلك بسهولة.</p>
          </div>
        </div>
        <div class="step">
          <div class="step__num">5</div>
          <div class="step__content">
            <h3>تابع وقيّم</h3>
            <p>راقب مدى استجابة طفلك للأداة خلال أسبوعين وقيّم التقدم. تواصل مع أخصائي التربية الخاصة إذا احتجت لتوجيه إضافي.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational Context -->
  <section class="context-section">
    <div class="container--narrow">
      <span class="badge">لماذا هذه الأدوات؟</span>
      <h2 class="section-title">الأساس العلمي وراء أدواتنا</h2>
      <div class="context-prose">
        <p>
          الأدوات التعليمية التي نقدمها ليست اختراعاً من عندنا — بل هي مبنية على استراتيجيات
          مدعومة بأبحاث علمية راسخة في مجال التربية الخاصة وتحليل السلوك التطبيقي.
        </p>
        <p>
          <strong>الجداول البصرية</strong> مبنية على مبادئ التعلم البصري التي أثبتت الأبحاث
          أن أطفال الطيف يتفوقون فيها على التعلم السمعي بشكل ملحوظ. دراسات عديدة نُشرت
          في مجلة <em>Journal of Applied Behavior Analysis</em> تؤكد أن الجداول البصرية تُقلّل
          السلوكيات الإشكالية وتُعزز الاستقلالية.
        </p>
        <p>
          <strong>القصص الاجتماعية</strong> طوّرتها Carol Gray في مطلع التسعينيات، وأصبحت
          اليوم إحدى أكثر أساليب التدخل توثيقاً لمساعدة أطفال الطيف على فهم السياق الاجتماعي
          والاستجابة بشكل مناسب للمواقف اليومية.
        </p>
        <p>
          <strong>لوحات التواصل البديل</strong> جزء من منظومة التواصل المعزز والبديل (AAC)
          التي تُعدّ ركيزة أساسية في خطط التدخل المبكر، وتوصي بها منظمة ASHA (جمعية النطق
          والسمع الأمريكية) لجميع الأطفال الذين يعانون من صعوبات في التواصل اللفظي.
        </p>
        <div class="info-box">
          <p style="margin-bottom:0;">
            <strong>تذكير مهم:</strong> هذه الأدوات مساعِدة وليست بديلاً عن خطة التدخل
            الفردية التي يضعها الفريق المتخصص لطفلك. استخدمها كإضافة لما يوصي به المختصون.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container--narrow">
      <div class="cta-box">
        <div class="cta-box__icon">📝</div>
        <h2 class="cta-box__title">اقترح أداة جديدة</h2>
        <p class="cta-box__text">
          هل تحتاج لأداة تعليمية معينة لا تجدها هنا؟ أخبرنا وسنعمل على توفيرها في أقرب
          وقت. مقترحاتك تُساعدنا على بناء مكتبة أدوات تلبّي الاحتياجات الحقيقية للأسر.
        </p>
        <a href="/contact/" class="btn btn--primary">اقترح أداة</a>
      </div>
    </div>
  </section>

  <!-- Ad Slot Bottom -->
  <div class="container">
    <div class="ad-slot">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="9988001122"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>
  </div>

</BaseLayout>

<style>
  /* Hero */
  .page-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, #145749 100%);
    color: #fff;
    padding: var(--space-lg) 0 var(--space-md);
    text-align: center;
  }

  .page-hero .badge {
    background: rgba(255,255,255,0.2);
    color: #fff;
  }

  .page-hero__title {
    font-size: clamp(1.65rem, 3.8vw, 2.5rem);
    font-weight: 800;
    color: #fff;
    margin: var(--space-xs) 0;
  }

  .page-hero__lead {
    font-size: 1rem;
    color: rgba(255,255,255,0.88);
    max-width: 640px;
    margin: 0 auto var(--space-md);
    line-height: 1.8;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .stat {
    text-align: center;
  }

  .stat__num {
    display: block;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--color-accent);
    line-height: 1.1;
  }

  .stat__label {
    display: block;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.75);
    margin-top: 0.2rem;
  }

  /* Intro Note */
  .intro-note-section {
    padding: var(--space-md) 0;
  }

  .intro-note {
    display: flex;
    gap: var(--space-sm);
    background: #fff8e1;
    border: 1px solid #f4c06a;
    border-right: 4px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
  }

  .intro-note__icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .intro-note strong {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .intro-note p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0.3rem 0 0;
    line-height: 1.7;
  }

  /* Sections */
  .tools-section {
    padding: var(--space-xl) 0;
  }

  .section-header {
    margin-bottom: var(--space-lg);
  }

  .section-sub {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  /* Featured Tools Grid */
  .tools-featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .tool-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.25s, transform 0.25s;
  }

  .tool-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .tool-card--featured {
    border-top: 3px solid var(--color-primary);
  }

  .tool-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-xs);
  }

  .tool-card__emoji {
    font-size: 2.5rem;
  }

  .tool-card__cat {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 100px;
  }

  .tool-card__title {
    font-size: 1.1rem;
    color: var(--color-primary);
    margin-bottom: 0.2rem;
  }

  .tool-card__subtitle {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: var(--space-sm);
    direction: ltr;
    text-align: right;
  }

  .tool-card__desc {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.7;
    margin-bottom: var(--space-xs);
    font-weight: 500;
  }

  .tool-card__long {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-sm);
    flex: 1;
  }

  .tool-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: var(--color-primary-xlight);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    margin-bottom: var(--space-sm);
  }

  .tool-info-item {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    align-items: flex-start;
  }

  .tool-info-icon {
    flex-shrink: 0;
  }

  .tool-card__btn {
