const description = 'دليل تفصيلي يوضح للآباء رحلة تشخيص طيف التوحد خطوة بخطوة: من الاستبيانات الأولية إلى اختبارات ADOS-2 و ADI-R المعتمدة وفريق التقييم متعدد التخصصات.';
const canonicalUrl = 'https://easyspot.online/articles/autism-evaluation-steps/';
