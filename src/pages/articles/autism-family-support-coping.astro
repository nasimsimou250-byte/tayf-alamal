    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--color-text);
    margin: var(--space-xs) 0 var(--space-md);
    line-height: 1.35;
  }
  .article-hero__lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.85;
    margin-bottom: var(--space-md);
  }
