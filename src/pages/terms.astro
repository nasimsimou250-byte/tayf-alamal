---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'الشروط والأحكام';
const description = 'الشروط والأحكام الخاصة باستخدام موقع طيف الأمل — حقوق الملكية الفكرية، قواعد الاستخدام، وإخلاء المسؤولية القانونية.';
const lastUpdated = 'سبتمبر 2026';
---

<BaseLayout title={title} description={description}>

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container--narrow">
      <span class="badge">قانوني</span>
      <h1 class="page-hero__title">الشروط والأحكام (Terms & Conditions)</h1>
      <p class="page-hero__lead">
        تحدد هذه الشروط والأحكام القواعد واللوائح المنظمة لاستخدامك لموقع "طيف الأمل" (easyspot.online). بدخولك وتصفحك للموقع، فإنك توافق على الالتزام الكامل بهذه الشروط.
      </p>
      <p class="last-updated">آخر تحديث: {lastUpdated}</p>
    </div>
  </section>

  <!-- Table of Contents -->
  <section class="policy-section">
    <div class="container--narrow">
      <div class="toc-box">
        <h2 class="toc-title">📋 فهرس الشروط والأحكام</h2>
        <ol class="toc-list">
          <li><a href="#acceptance">1. قبول الشروط والأحكام</a></li>
          <li><a href="#intellectual-property">2. حقوق الملكية الفكرية والنشر</a></li>
          <li><a href="#permitted-use">3. الاستخدام المسموح به للأدوات التعليمية</a></li>
          <li><a href="#prohibited-use">4. الاستخدامات المحظورة والممنوعة</a></li>
          <li><a href="#medical-nature">5. الطبيعة التثقيفية للمحتوى وعدم تقديم استشارات طبية</a></li>
          <li><a href="#third-party-ads">6. روابط الأطراف الثالثة وإعلانات Google AdSense</a></li>
          <li><a href="#limitation-liability">7. إخلاء المسؤولية وحدود الالتزام</a></li>
          <li><a href="#modifications">8. تعديل وتحديث الشروط</a></li>
          <li><a href="#contact">9. كيفية التواصل معنا</a></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="policy-section">
    <div class="container--narrow content-block">

      <div class="section-block" id="acceptance">
        <h2>1. قبول الشروط والأحكام</h2>
        <p>
          مرحباً بكم في موقع <strong>طيف الأمل</strong> (المتاح عبر النطاق: <code>easyspot.online</code>). إن وصولك إلى هذا الموقع أو استخدام أي من مقالاته، أدواته، وألعابه التعليمية يعني موافقتك الصريحة والكاملة دون قيد أو شرط على الالتزام بجميع بنود هذه الاتفاقية وسياسة الخصوصية وإخلاء المسؤولية المعتمدة لدينا. إذا كنت لا توافق على أي جزء من هذه الشروط، فيرجى التوقف عن استخدام الموقع فوراً.
        </p>
      </div>

      <div class="section-block" id="intellectual-property">
        <h2>2. حقوق الملكية الفكرية والنشر</h2>
        <p>
          ما لم يُنص على خلاف ذلك صراحة، فإن جميع المواد المنشورة على هذا الموقع — بما في ذلك على سبيل المثال لا الحصر: النصوص المكتوبة، المقالات العلمية، التصاميم، الشعارات، الأيقونات، البرمجيات التفاعلية، والأكواد المصدرية — هي ملكية فكرية حصرية لموقع <strong>طيف الأمل</strong> ومحمية بموجب قوانين الملكية الفكرية وحقوق النشر الدولية.
        </p>
        <p>
          يُحظر تماماً نسخ أو إعادة نشر أو بيع أو تأجير أو استغلال أي جزء من محتوى الموقع لأغراض تجارية دون الحصول على إذن خطي مسبق وصريح من إدارة الموقع.
        </p>
      </div>

      <div class="section-block" id="permitted-use">
        <h2>3. الاستخدام المسموح به للأدوات التعليمية</h2>
        <p>
          نمنح أولياء الأمور، المعلمين، وأخصائيي التربية الخاصة ترخيصاً شخصياً ومجانياً وغير حصري من أجل:
        </p>
        <ul>
          <li>تحميل وطباعة الجداول البصرية، البطاقات التعليمية، ولوحات التواصل المتاحة في قسم "الأدوات" لأغراض التدريب والتعليم الشخصي في المنزل أو داخل الفصول الدراسية.</li>
          <li>مشاركة روابط مقالات الموقع عبر وسائل التواصل الاجتماعي أو التطبيقات التراسلية لتعميم الفائدة التوعوية، شريطة ذكر المصدر مع رابط مباشر للمقال الأصلي.</li>
          <li>استخدام الألعاب التعليمية والحسية المتاحة عبر المتصفح للأطفال تحت إشراف الوالدين.</li>
        </ul>
      </div>

      <div class="section-block" id="prohibited-use">
        <h2>4. الاستخدامات المحظورة والممنوعة</h2>
        <p>عند استخدام موقع طيف الأمل، فإنك تتعهد بعدم القيام بأي من الأفعال التالية:</p>
        <ul>
          <li>استخدام الموقع بأي شكل قد يعطل، أو يثقل، أو يلحق ضرراً بخوادم الموقع أو الشبكات المتصلة به.</li>
          <li>استخدام برامج جمع البيانات الآلية، أو عناكب الاستخلاص (Scraping/Crawling)، أو روبوتات النسخ الآلي دون إذن مكتوب.</li>
          <li>محاولة اختراق أنظمة الموقع أو الوصول غير المصرح به إلى أي من بيانات المستخدمين أو السيرفرات.</li>
          <li>استخدام أي محتوى من الموقع في أنشطة تنتهك القوانين والأنظمة المعمول بها دولياً أو محلياً.</li>
        </ul>
      </div>

      <div class="section-block" id="medical-nature">
        <h2>5. الطبيعة التثقيفية وعدم تقديم استشارات طبية</h2>
        <p>
          المعلومات والمقالات والأدوات المنشورة على موقع طيف الأمل مُعدة لأغراض تثقيفية وتوعوية وإرشادية عامة فقط. لا يشكل أي محتوى على هذا الموقع — صراحة أو ضمناً — استشارة طبية أو تشخيصاً نفسياً أو خطة علاجية مخصصة لطفل بعينه.
        </p>
        <p>
          يجب دائماً مراجعة طبيب نمو وتطور الأطفال، أو أخصائي أعصاب أطفال، أو معالج سلوكي معتمد قبل اتخاذ أي قرار علاجي أو تغيير في حمية الطفل أو خطته التأهيلية.
        </p>
      </div>

      <div class="section-block" id="third-party-ads">
        <h2>6. روابط الأطراف الثالثة وإعلانات Google AdSense</h2>
        <p>
          قد يعرض الموقع إعلانات تابعة لشبكة <strong>Google AdSense</strong> أو خدمات إعلانية أخرى موثوقة، وقد يحتوي على روابط تقود إلى مواقع خارجية مستقلة.
        </p>
        <ul>
          <li>لا نتحكم في محتوى أو سياسات خصوصية أو ممارسات المواقع الخارجية التابعة لأطراف ثالثة.</li>
          <li>إن ظهور أي إعلان على موقعنا لا يعني بالضرورة تزكية أو مصادقة الموقع على المنتج أو الخدمة المعلنة.</li>
          <li>ننصح المستخدمين بالاطلاع على شروط وأحكام وسياسة خصوصية أي موقع خارجي يزورونه.</li>
        </ul>
      </div>

      <div class="section-block" id="limitation-liability">
        <h2>7. إخلاء المسؤولية وحدود الالتزام</h2>
        <p>
          يُقدم الموقع ومحتوياته "كما هي" (As Is) و"حسب توفرها" (As Available) دون أي ضمانات من أي نوع، سواء كانت صريحة أو ضمنية. لا تضمن إدارة الموقع استمرار عمل الموقع دون انقطاع أو خلوه التام من الأخطاء التقنية الطارئة.
        </p>
        <p>
          إلى أقصى حد يسمح به القانون، لا يتحمل موقع طيف الأمل أو المشرفون عليه أي مسؤولية قانونية عن أي أضرار مباشرة أو غير مباشرة أو تبعية قد تنشأ عن استخدامك للموقع أو الاعتماد على أي معلومة واردة فيه.
        </p>
      </div>

      <div class="section-block" id="modifications">
        <h2>8. تعديل وتحديث الشروط</h2>
        <p>
          يحتفظ موقع طيف الأمل بالحق الكامل في تعديل أو تغيير أو استبدال أي جزء من هذه الشروط والأحكام في أي وقت ودون إشعار مسبق. يسري مفعول أي تعديل فور نشره مباشرة على هذه الصفحة، مع تحديث تاريخ "آخر تحديث" في أعلى المستند. ويُعد استمرارك في استخدام الموقع بعد نشر أي تعديلات قبولاً ضمنياً ومباشراً منك بتلك التعديلات.
        </p>
      </div>

      <div class="section-block" id="contact">
        <h2>9. كيفية التواصل معنا</h2>
        <p>
          إذا كان لديك أي سؤال أو استفسار بخصوص هذه الشروط والأحكام، يسعدنا تواصلك معنا مباشرة عبر:
        </p>
        <ul>
          <li>البريد الإلكتروني المباشر: <a href="mailto:contact@easyspot.online" dir="ltr">contact@easyspot.online</a></li>
          <li>صفحة الدعم والمراسلة: <a href="/contact/">صفحة تواصل معنا</a></li>
        </ul>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-primary-xlight) 0%, #ffffff 70%);
    padding: var(--space-xl) 0 var(--space-lg);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }
  .page-hero__title {
    font-size: clamp(1.8rem, 3.8vw, 2.5rem);
    color: var(--color-text);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .page-hero__lead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 680px;
    margin: 0 auto var(--space-sm);
  }
  .last-updated {
    font-size: 0.9rem;
    color: var(--color-primary);
    font-weight: 700;
    margin-bottom: 0;
  }
  .policy-section {
    padding: var(--space-xl) 0;
  }
  .toc-box {
    background: #f7fafc;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }
  .toc-title {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }
  .toc-list {
    margin: 0;
    padding-right: 1.5rem;
  }
  .toc-list li {
    margin-bottom: 0.5rem;
  }
  .toc-list a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
  }
  .toc-list a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .content-block {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    box-shadow: var(--shadow-sm);
  }
  .section-block {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-primary-xlight);
  }
  .section-block:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .section-block h2 {
    font-size: 1.35rem;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }
  .section-block p {
    line-height: 1.9;
    color: #2d3748;
    margin-bottom: var(--space-sm);
  }
  .section-block ul {
    padding-right: 1.5rem;
    margin-bottom: var(--space-sm);
  }
  .section-block li {
    line-height: 1.8;
    color: #2d3748;
    margin-bottom: 0.4rem;
  }
</style>
