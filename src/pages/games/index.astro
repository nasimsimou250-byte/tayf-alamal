---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'ألعاب تعليمية تفاعلية لأطفال طيف التوحد';
const description = 'ألعاب تفاعلية مبسطة ومناسبة حسياً لأطفال طيف التوحد — مطابقة المشاعر، لعبة الذاكرة البصرية، فرز الألوان، وفقاعات التهدئة الحسية.';
---

<BaseLayout title={title} description={description}>

  <!-- Fullscreen Confetti Canvas -->
  <canvas id="confettiCanvas" class="confetti-canvas"></canvas>

  <!-- Grand Celebration Modal (End Game Motion) -->
  <div id="celebrationModal" class="celebration-modal" style="display: none;">
    <div class="celebration-backdrop"></div>
    <div class="celebration-card">
      <div class="trophy-bounce">🏆</div>
      <div class="celebration-stars">⭐⭐⭐⭐⭐</div>
      <h2 class="celebration-title">🎉 بطل طيف الأمل الرائع! 🎉</h2>
      <p class="celebration-desc">لقد طابقت جميع البطاقات بنجاح وأنهيت اللعبة بذكاء وتركيز فائق!</p>
      <div class="celebration-badge">
        <span>🎖️ وسام الذاكرة الذهبية</span>
      </div>
      <div class="celebration-actions">
        <button type="button" class="btn btn--primary btn--pulse" id="modalRestartBtn">
          🔁 العب جولة جديدة من البطاقات 🚀
        </button>
      </div>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="games-hero">
    <div class="container">
      <span class="badge">بيئة تفاعلية هادئة وممتعة</span>
      <h1 class="games-hero__title">ألعاب تعليمية حسية للأطفال</h1>
      <p class="games-hero__desc">
        ألعاب مصممة خصيصاً لتناسب احتياجات أطفال طيف التوحد: بدون مؤقتات ضاغطة، بأزرار واضحة وألوان مبهجة ومريحة للعين،
        وأصوات لطيفة تعزز الفهم البصري والتفاعل الذكي.
      </p>

      <div class="game-tabs">
        <button type="button" class="tab-btn tab-btn--active" data-game="emotions">
          😊 مطابقة وفهم المشاعر
        </button>
        <button type="button" class="tab-btn" data-game="memory">
          🃏 لعبة بطاقات الذاكرة
        </button>
        <button type="button" class="tab-btn" data-game="sorting">
          🎨 فرز الألوان السحري
        </button>
        <button type="button" class="tab-btn" data-game="bubbles">
          🫧 فقاعات التهدئة الحسية
        </button>
      </div>
    </div>
  </section>

  <!-- Interactive Game Arena -->
  <section class="game-arena-section">
    <div class="container">
      <div class="game-box">

        <!-- Controls Bar -->
        <div class="game-controls">
          <div class="game-info">
            <span id="activeGameTitle" class="game-active-title">😊 مطابقة وفهم المشاعر</span>
            <span class="game-stars" id="starCounter">⭐ النجوم المحصودة: <strong id="scoreNum">0</strong></span>
          </div>
          <button type="button" class="sound-toggle-btn" id="soundToggle" title="كتم / تفعيل الصوت">
            🔊 الصوت مُفعّل
          </button>
        </div>

        <!-- GAME 1: EMOTIONS MATCHING (Big & Fun Response Boxes) -->
        <div class="game-container game-container--active" id="game-emotions">
          <div class="game-prompt">
            <div class="prompt-speech-bubble">
              <h2 id="emotionQuestion">ما هو شعور هذا الوجه الظريف؟ 🤔</h2>
            </div>
            <div class="large-emotion-card">
              <div class="large-emotion-display" id="currentEmojiDisplay">😊</div>
              <div class="emotion-glow-ring"></div>
            </div>
          </div>

          <div class="options-grid" id="emotionsOptionsGrid">
            <!-- Rendered dynamically by JS with Big, Fun, 3D Colorful Buttons -->
          </div>

          <div class="feedback-banner" id="emotionsFeedback" style="display: none;"></div>
        </div>

        <!-- GAME 2: MEMORY MATCH (Bigger Cards & Victory Celebration) -->
        <div class="game-container" id="game-memory">
          <div class="memory-header">
            <h3>اقلب البطاقات وابحث عن الصورتين المتطابقتين 🧩</h3>
            <p>لا يوجد وقت محدد يضغطك — خذ كل وقتك براحة وهدوء وسرور.</p>
          </div>

          <div class="memory-grid" id="memoryGrid">
            <!-- Rendered dynamically by JS with Big 3D Flipping Cards -->
          </div>

          <!-- Bottom trigger bar if needed -->
          <div class="memory-bottom-bar">
            <button type="button" class="btn btn--outline" id="restartMemoryBtnManual">
              🔄 إعادة خلط البطاقات
            </button>
          </div>
        </div>

        <!-- GAME 3: COLOR SORTING -->
        <div class="game-container" id="game-sorting">
          <div class="sorting-header">
            <h3>ضع العنصر في السلة ذات اللون المطابق 🧺</h3>
            <p>انقر على السلة الصحيحة التي تناسب لون هذا العنصر:</p>
          </div>
          <div class="current-item-box">
            <div class="item-display" id="sortingCurrentItem">🍎</div>
            <div class="item-label" id="sortingCurrentLabel">تفاحة حمراء شهية</div>
          </div>
          <div class="baskets-grid">
            <button type="button" class="basket-btn basket-red" data-color="red">
              <span class="basket-icon">🧺</span>
              <span class="basket-label">سلة الأحمر</span>
            </button>
            <button type="button" class="basket-btn basket-green" data-color="green">
              <span class="basket-icon">🧺</span>
              <span class="basket-label">سلة الأخضر</span>
            </button>
            <button type="button" class="basket-btn basket-blue" data-color="blue">
              <span class="basket-icon">🧺</span>
              <span class="basket-label">سلة الأزرق</span>
            </button>
            <button type="button" class="basket-btn basket-yellow" data-color="yellow">
              <span class="basket-icon">🧺</span>
              <span class="basket-label">سلة الأصفر</span>
            </button>
          </div>
          <div class="feedback-banner" id="sortingFeedback" style="display: none;"></div>
        </div>

        <!-- GAME 4: SENSORY BUBBLES POPPER -->
        <div class="game-container" id="game-bubbles">
          <div class="bubbles-header">
            <h3>🫧 فقاعات التهدئة والاسترخاء الحسي</h3>
            <p>المس أو انقر على الفقاعات لتفرقعها بلطف بنعومة وصوت لطيف يهدئ التوتر الحسي.</p>
          </div>
          <div class="bubbles-stage" id="bubblesStage">
            <div class="bubbles-hint">✨ انقر أو المس الشاشة لتوليد فقاعات جديدة ✨</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Educational Benefits for Parents -->
  <section class="benefits-section">
    <div class="container">
      <div class="section-header">
        <span class="badge">الفوائد العلاجية والتطورية</span>
        <h2 class="section-title">كيف تدعم هذه الألعاب نمو طفلك؟</h2>
      </div>
      <div class="benefits-grid">
        <div class="benefit-card">
          <span class="benefit-icon">🧠</span>
          <h3>الذكاء العاطفي والتعبير</h3>
          <p>أطفال التوحد يواجهون تحدياً في قراءة تعابير الوجه. لعبة المشاعر تُترجم العواطف لرموز واضحة تُنمّي التواصل والتعاطف.</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🎯</span>
          <h3>الذاكرة البصرية والانتباه</h3>
          <p>لعبة مطابقة البطاقات تُحفّز التركيز البصري والذاكرة قصيرة المدى دون أي ضغط زمني يسبب القلق.</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🎨</span>
          <h3>التصنيف والتنظيم المعرفي</h3>
          <p>فرز الألوان يدعم مهارات التصنيف الأساسية التي تُعدّ ركيزة لتعلم المفاهيم الرياضية واللغوية اللاحقة.</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🫧</span>
          <h3>التنظيم الحسي وخفض التوتر</h3>
          <p>فرقعة الفقاعات البصرية الهادئة تُساعد على استعادة الهدوء بعد نوبات التحفيز الحسي الزائد (Sensory Overload).</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Confetti Fullscreen Canvas */
  .confetti-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9999;
    display: none;
  }

  /* Celebration Modal (End Game Motion) */
  .celebration-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .celebration-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 45, 38, 0.75);
    backdrop-filter: blur(8px);
    animation: fadeIn 0.3s ease;
  }

  .celebration-card {
    position: relative;
    background: #ffffff;
    border: 4px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    max-width: 520px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    animation: popBounce 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 10;
  }

  @keyframes popBounce {
    0% { transform: scale(0.4) translateY(40px); opacity: 0; }
    70% { transform: scale(1.08) translateY(-10px); }
    100% { transform: scale(1) translateY(0); opacity: 1; }
  }

  .trophy-bounce {
    font-size: 5rem;
    margin-bottom: 0.5rem;
    display: inline-block;
    animation: trophyWiggle 1.5s infinite ease-in-out;
  }

  @keyframes trophyWiggle {
    0%, 100% { transform: rotate(0deg) scale(1); }
    25% { transform: rotate(-10deg) scale(1.1); }
    75% { transform: rotate(10deg) scale(1.1); }
  }

  .celebration-stars {
    font-size: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: 0.3rem;
  }

  .celebration-title {
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .celebration-desc {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .celebration-badge {
    display: inline-block;
    background: #fef3e2;
    color: #b7791f;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    padding: 0.5rem 1.25rem;
    border-radius: 100px;
    border: 2px dashed var(--color-accent);
    margin-bottom: 1.5rem;
  }

  .btn--pulse {
    font-size: 1.15rem;
    padding: 0.95rem 2.2rem;
    border-radius: 100px;
    box-shadow: 0 0 0 0 rgba(26, 107, 90, 0.7);
    animation: pulseButton 1.8s infinite;
  }

  @keyframes pulseButton {
    0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(26, 107, 90, 0.4); }
    70% { transform: scale(1.04); box-shadow: 0 0 0 16px rgba(26, 107, 90, 0); }
    100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(26, 107, 90, 0); }
  }

  /* Hero Section */
  .games-hero {
    background: linear-gradient(135deg, var(--color-primary-xlight) 0%, #fff 60%);
    padding: var(--space-lg) 0 var(--space-md);
    text-align: center;
  }

  .games-hero__title {
    font-size: clamp(1.65rem, 3.8vw, 2.5rem);
    font-weight: 900;
    color: var(--color-text);
    margin: var(--space-xs) 0;
  }

  .games-hero__desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 680px;
    margin: 0 auto var(--space-md);
    line-height: 1.8;
  }

  /* Game Tabs */
  .game-tabs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }

  .tab-btn {
    padding: 0.6rem 1.35rem;
    border-radius: 100px;
    border: 2px solid var(--color-border);
    background: var(--color-surface);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-2px);
  }

  .tab-btn--active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
    box-shadow: 0 4px 14px rgba(26, 107, 90, 0.25);
  }

  /* Arena Box */
  .game-arena-section {
    padding: var(--space-md) 0 var(--space-xl);
  }

  .game-box {
    background: #ffffff;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    min-height: 540px;
    display: flex;
    flex-direction: column;
  }

  .game-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-primary-xlight);
    border-bottom: 2px solid var(--color-border);
    padding: 0.75rem 1.25rem;
  }

  .game-info {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .game-active-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--color-primary);
  }

  .game-stars {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: #b7791f;
    background: #fefcbf;
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    border: 1px solid #f6e05e;
  }

  .sound-toggle-btn {
    background: #fff;
    border: 1.5px solid var(--color-border);
    padding: 0.4rem 0.95rem;
    border-radius: 100px;
    font-size: 0.88rem;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text);
    transition: all 0.2s;
  }

  .sound-toggle-btn:hover {
    border-color: var(--color-primary);
  }

  /* Containers */
  .game-container {
    display: none;
    padding: var(--space-lg);
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .game-container--active {
    display: flex;
  }

  /* =========================================
     GAME 1: EMOTIONS MATCHING (Big & Funny!)
     ========================================= */
  .prompt-speech-bubble {
    background: #f0fdf4;
    border: 2px dashed #48bb78;
    border-radius: 20px;
    padding: 0.75rem 1.75rem;
    display: inline-block;
    margin-bottom: var(--space-sm);
  }

  .prompt-speech-bubble h2 {
    font-size: 1.45rem;
    color: #22543d;
    margin: 0;
  }

  .large-emotion-card {
    position: relative;
    display: inline-block;
    padding: 1rem;
    margin-bottom: var(--space-md);
  }

  .large-emotion-display {
    font-size: 7.5rem;
    line-height: 1;
    display: block;
    animation: playfulFloat 2.4s infinite ease-in-out;
    filter: drop-shadow(0 12px 20px rgba(0,0,0,0.12));
  }

  @keyframes playfulFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    33% { transform: translateY(-10px) rotate(-3deg); }
    66% { transform: translateY(-4px) rotate(3deg); }
  }

  /* BIG & FUNNIER OPTIONS GRID */
  .options-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    max-width: 580px;
    width: 100%;
    margin: 0 auto;
  }

  .option-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    padding: 1.25rem 1.5rem;
    border-radius: 22px;
    border: 3.5px solid;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.25rem;
    cursor: pointer;
    transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease;
    user-select: none;
    box-shadow: 0 6px 0 rgba(0, 0, 0, 0.12);
  }

  .option-btn:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 10px 0 rgba(0, 0, 0, 0.14);
  }

  .option-btn:active {
    transform: translateY(4px);
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.12);
  }

  /* 4 Colorful Themes for Options */
  .option-btn-theme-0 {
    background: #fff9db;
    border-color: #f59f00;
    color: #d9480f;
  }
  .option-btn-theme-1 {
    background: #e7f5ff;
    border-color: #339af0;
    color: #1864ab;
  }
  .option-btn-theme-2 {
    background: #ebfbee;
    border-color: #51cf66;
    color: #2b8a3e;
  }
  .option-btn-theme-3 {
    background: #f3f0ff;
    border-color: #845ef7;
    color: #5f3dc4;
  }

  .option-emoji-icon {
    font-size: 1.8rem;
  }

  .option-text-label {
    flex: 1;
    text-align: right;
  }

  /* Feedback */
  .feedback-banner {
    margin-top: var(--space-md);
    padding: 1rem 2rem;
    border-radius: 16px;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    animation: popBounce 0.35s ease;
  }

  .feedback-success {
    background: #c6f6d5;
    color: #22543d;
    border: 3px solid #68d391;
    box-shadow: 0 8px 24px rgba(72, 187, 120, 0.3);
  }

  .feedback-retry {
    background: #fefcbf;
    color: #744210;
    border: 3px solid #ecc94b;
    animation: funnyWobble 0.5s ease;
  }

  @keyframes funnyWobble {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-12px); }
    40% { transform: translateX(12px); }
    60% { transform: translateX(-8px); }
    80% { transform: translateX(8px); }
  }

  /* =========================================
     GAME 2: MEMORY MATCH (Bigger Cards & 3D Flip)
     ========================================= */
  .memory-header h3 {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .memory-header p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: var(--space-md);
  }

  .memory-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1rem;
    max-width: 620px;
    width: 100%;
    margin: 0 auto;
    perspective: 800px;
  }

  .memory-card {
    height: 125px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    cursor: pointer;
    user-select: none;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.2s;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
    position: relative;
    border: 3.5px solid transparent;
  }

  .memory-card:hover {
    transform: translateY(-5px) scale(1.03);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
  }

  /* Card Hidden Face (Playful 3D Back) */
  .memory-card.is-hidden-face {
    background: linear-gradient(135deg, #1a6b5a 0%, #2d8f78 100%);
    border-color: #38a169;
  }

  .memory-card.is-hidden-face::after {
    content: '⭐';
    font-size: 2.2rem;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
  }

  .memory-card.is-flipped {
    background: #ffffff;
    border-color: var(--color-accent);
    transform: rotateY(180deg) scale(1.02);
  }

  .memory-card.is-matched {
    background: #e6fffa;
    border-color: #38a169;
    cursor: default;
    animation: matchSuccessPulse 0.6s ease;
  }

  .memory-card.is-matched::before {
    content: '✅';
    position: absolute;
    top: 6px;
    left: 8px;
    font-size: 1.1rem;
  }

  @keyframes matchSuccessPulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.15) rotate(4deg); }
    100% { transform: scale(1); }
  }

  .memory-card .card-face {
    display: none;
  }

  .memory-card.is-flipped .card-face,
  .memory-card.is-matched .card-face {
    display: block;
    animation: popBounce 0.3s ease;
  }

  .memory-card.is-flipped::after,
  .memory-card.is-matched::after {
    display: none;
  }

  .memory-bottom-bar {
    margin-top: var(--space-md);
  }

  /* =========================================
     GAME 3: SORTING
     ========================================= */
  .sorting-header h3 {
    font-size: 1.3rem;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .sorting-header p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
