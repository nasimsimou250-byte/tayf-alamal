---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'ألعاب تعليمية تفاعلية لأطفال طيف التوحد';
const description = 'ألعاب تفاعلية مبسطة ومناسبة حسياً لأطفال طيف التوحد — مطابقة المشاعر، لعبة الذاكرة البصرية، فرز الألوان، وفقاعات التهدئة الحسية.';
---

<BaseLayout title={title} description={description}>

  <!-- Hero Section -->
  <section class="games-hero">
    <div class="container">
      <span class="badge">بيئة تفاعلية هادئة</span>
      <h1 class="games-hero__title">ألعاب تعليمية حسية للأطفال</h1>
      <p class="games-hero__desc">
        ألعاب مصممة خصيصاً لتناسب احتياجات أطفال طيف التوحد: بدون مؤقتات ضاغطة، بألوان مريحة للعين،
        وأصوات لطيفة تعزز التعلم البصري، التركيز، وتطوير المهارات الحركية والتواصلية.
      </p>

      <div class="game-tabs">
        <button type="button" class="tab-btn tab-btn--active" data-game="emotions">
          😊 مطابقة المشاعر
        </button>
        <button type="button" class="tab-btn" data-game="memory">
          🃏 الذاكرة البصرية
        </button>
        <button type="button" class="tab-btn" data-game="sorting">
          🎨 فرز الألوان
        </button>
        <button type="button" class="tab-btn" data-game="bubbles">
          🫧 فقاعات التهدئة
        </button>
      </div>
    </div>
  </section>

  <!-- Interactive Game Arena -->
  <section class="game-arena-section">
    <div class="container">
      <div class="game-box">

        <!-- Controls Bar -->
        <div class="game-controls">
          <div class="game-info">
            <span id="activeGameTitle" class="game-active-title">😊 لعبة مطابقة المشاعر</span>
            <span class="game-stars" id="starCounter">⭐ النجوم: <strong id="scoreNum">0</strong></span>
          </div>
          <button type="button" class="sound-toggle-btn" id="soundToggle" title="كتم / تفعيل الصوت">
            🔊 الصوت مُفعّل
          </button>
        </div>

        <!-- GAME 1: EMOTIONS MATCHING -->
        <div class="game-container game-container--active" id="game-emotions">
          <div class="game-prompt">
            <h2 id="emotionQuestion">ما هو شعور هذا الوجه؟</h2>
            <div class="large-emotion-display" id="currentEmojiDisplay">😊</div>
          </div>
          <div class="options-grid" id="emotionsOptionsGrid">
            <!-- Rendered by JS -->
          </div>
          <div class="feedback-banner" id="emotionsFeedback" style="display: none;"></div>
        </div>

        <!-- GAME 2: MEMORY MATCH -->
        <div class="game-container" id="game-memory">
          <div class="memory-header">
            <h3>اقلب البطاقات وابحث عن الصورتين المتطابقتين 🧩</h3>
            <p>لا يوجد وقت محدد — خذ كل وقتك براحة وهدوء.</p>
          </div>
          <div class="memory-grid" id="memoryGrid">
            <!-- Rendered by JS -->
          </div>
          <div class="memory-win-msg" id="memoryWin" style="display: none;">
            <div class="win-icon">🎉 🌟 👏</div>
            <h3>أحسنت صنعاً يا بطل!</h3>
            <p>لقد وجدت جميع البطاقات المتطابقة بنجاح!</p>
            <button type="button" class="btn btn--primary" id="restartMemoryBtn">العب مرة أخرى</button>
          </div>
        </div>

        <!-- GAME 3: COLOR SORTING -->
        <div class="game-container" id="game-sorting">
          <div class="sorting-header">
            <h3>ضع العنصر في السلة ذات اللون المطابق 🧺</h3>
            <p>انقر على السلة الصحيحة التي تناسب لون هذا العنصر:</p>
          </div>
          <div class="current-item-box">
            <div class="item-display" id="sortingCurrentItem">🍎</div>
            <div class="item-label" id="sortingCurrentLabel">تفاحة حمراء</div>
          </div>
          <div class="baskets-grid">
            <button type="button" class="basket-btn basket-red" data-color="red">
              <span class="basket-icon">🧺</span>
              <span class="basket-label">سلة الأحمر</span>
            </button>
            <button type="button" class="basket-btn basket-green" data-color="green">
              <span class="basket-icon">🧺</span>
              <span class="basket-label">سلة الأخضر</span>
            </button>
            <button type="button" class="basket-btn basket-blue" data-color="blue">
              <span class="basket-icon">🧺</span>
              <span class="basket-label">سلة الأزرق</span>
            </button>
            <button type="button" class="basket-btn basket-yellow" data-color="yellow">
              <span class="basket-icon">🧺</span>
              <span class="basket-label">سلة الأصفر</span>
            </button>
          </div>
          <div class="feedback-banner" id="sortingFeedback" style="display: none;"></div>
        </div>

        <!-- GAME 4: SENSORY BUBBLES POPPER -->
        <div class="game-container" id="game-bubbles">
          <div class="bubbles-header">
            <h3>🫧 فقاعات التهدئة والاسترخاء الحسي</h3>
            <p>المس أو انقر على الفقاعات لتفرقعها بلطف. هذه اللعبة تمنح تأثيراً حسياً مهدئاً يقلل التوتر.</p>
          </div>
          <div class="bubbles-stage" id="bubblesStage">
            <div class="bubbles-hint">انقر في أي مكان لتوليد فقاعات جديدة ✨</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Educational Benefits for Parents -->
  <section class="benefits-section">
    <div class="container">
      <div class="section-header">
        <span class="badge">الفوائد العلاجية</span>
        <h2 class="section-title">كيف تدعم هذه الألعاب طفلك؟</h2>
      </div>
      <div class="benefits-grid">
        <div class="benefit-card">
          <span class="benefit-icon">🧠</span>
          <h3>التعرف على المشاعر</h3>
          <p>أطفال التوحد يواجهون صعوبة في قراءة تعابير الوجه. لعبة مطابقة المشاعر تُترجم العواطف لرموز واضحة تُنمّي الذكاء العاطفي.</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🎯</span>
          <h3>الذاكرة العاملة والتركيز</h3>
          <p>لعبة مطابقة البطاقات تُحفّز الانتباه البصري والتركيز المتواصل بدون ضغط الوقت أو الخسارة.</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🎨</span>
          <h3>التصنيف والتنظيم المعرفي</h3>
          <p>فرز الألوان يدعم مهارات التصنيف الأساسية التي تُعدّ ركيزة لتعلم المفاهيم الرياضية واللغوية اللاحقة.</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🫧</span>
          <h3>التنظيم الحسي وخفض التوتر</h3>
          <p>فرقعة الفقاعات البصرية الهادئة تُساعد على استعادة الهدوء بعد نوبات التحفيز الحسي الزائد (Sensory Overload).</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .games-hero {
    background: linear-gradient(135deg, var(--color-primary-xlight) 0%, #fff 60%);
    padding: var(--space-lg) 0 var(--space-md);
    text-align: center;
  }

  .games-hero__title {
    font-size: clamp(1.65rem, 3.8vw, 2.5rem);
    font-weight: 900;
    color: var(--color-text);
    margin: var(--space-xs) 0;
  }

  .games-hero__desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 680px;
    margin: 0 auto var(--space-md);
    line-height: 1.8;
  }

  /* Game Tabs */
  .game-tabs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }

  .tab-btn {
    padding: 0.55rem 1.25rem;
    border-radius: 100px;
    border: 2px solid var(--color-border);
    background: var(--color-surface);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .tab-btn--active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
    box-shadow: 0 4px 14px rgba(26, 107, 90, 0.25);
  }

  /* Arena Box */
  .game-arena-section {
    padding: var(--space-md) 0 var(--space-xl);
  }

  .game-box {
    background: #ffffff;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    min-height: 500px;
    display: flex;
    flex-direction: column;
  }

  .game-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-primary-xlight);
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 1.25rem;
  }

  .game-info {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .game-active-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--color-primary);
  }

  .game-stars {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: #b7791f;
    background: #fefcbf;
    padding: 0.2rem 0.65rem;
    border-radius: 100px;
  }

  .sound-toggle-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    font-size: 0.85rem;
    cursor: pointer;
    font-family: var(--font-display);
    color: var(--color-text-muted);
  }

  /* Game Containers */
  .game-container {
    display: none;
    padding: var(--space-lg);
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .game-container--active {
    display: flex;
  }

  /* GAME 1: EMOTIONS */
  .game-prompt h2 {
    font-size: 1.35rem;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .large-emotion-display {
    font-size: 6.5rem;
    margin: var(--space-sm) 0 var(--space-md);
    animation: gentleBounce 2s infinite ease-in-out;
  }

  @keyframes gentleBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
    max-width: 480px;
    width: 100%;
  }

  .option-btn {
    padding: 1rem;
    border-radius: var(--radius-md);
    border: 2px solid var(--color-border);
    background: #fafcfb;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .option-btn:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-xlight);
    transform: translateY(-2px);
  }

  .feedback-banner {
    margin-top: var(--space-md);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    animation: fadeIn 0.3s ease;
  }

  .feedback-success {
    background: #c6f6d5;
    color: #22543d;
    border: 1px solid #9ae6b4;
  }

  .feedback-retry {
    background: #feebc8;
    color: #744210;
    border: 1px solid #fbd38d;
  }

  /* GAME 2: MEMORY */
  .memory-header h3 {
    font-size: 1.2rem;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .memory-header p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-md);
  }

  .memory-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    max-width: 460px;
    width: 100%;
    margin: 0 auto;
  }

  .memory-card {
    height: 95px;
    background: var(--color-primary);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    cursor: pointer;
    transition: transform 0.25s, background 0.25s;
    user-select: none;
    box-shadow: var(--shadow-sm);
  }

  .memory-card:hover {
    transform: scale(1.04);
  }

  .memory-card.is-flipped {
    background: #f7faf9;
    border: 2px solid var(--color-primary);
  }

  .memory-card.is-matched {
    background: #e6fffa;
    border: 2px solid #38a169;
    cursor: default;
    opacity: 0.85;
  }

  .memory-card .card-face {
    display: none;
  }

  .memory-card.is-flipped .card-face,
  .memory-card.is-matched .card-face {
    display: block;
  }

  .memory-card.is-hidden-face::after {
    content: '⭐';
    font-size: 1.7rem;
    opacity: 0.6;
  }

  .memory-card.is-flipped::after,
  .memory-card.is-matched::after {
    display: none;
  }

  .memory-win-msg {
    margin-top: var(--space-md);
    padding: var(--space-lg);
    background: #f0fff4;
    border: 2px solid #9ae6b4;
    border-radius: var(--radius-md);
  }

  .win-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  /* GAME 3: SORTING */
  .sorting-header h3 {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .sorting-header p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: var(--space-md);
  }

  .current-item-box {
    background: #fafcfb;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    margin-bottom: var(--space-lg);
    width: 200px;
  }

  .item-display {
    font-size: 4.5rem;
    line-height: 1;
    margin-bottom: 0.35rem;
  }

  .item-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .baskets-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
    max-width: 600px;
    width: 100%;
  }

  .basket-btn {
    border-radius: var(--radius-md);
    padding: 1rem 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    border: 2.5px solid;
    transition: transform 0.2s;
    background: #fff;
  }

  .basket-btn:hover {
    transform: translateY(-4px);
  }

  .basket-icon {
    font-size: 2.5rem;
    margin-bottom: 0.35rem;
  }

  .basket-label {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.88rem;
  }

  .basket-red { border-color: #e53e3e; color: #e53e3e; }
  .basket-green { border-color: #38a169; color: #38a169; }
  .basket-blue { border-color: #3182ce; color: #3182ce; }
  .basket-yellow { border-color: #d69e2e; color: #d69e2e; }

  /* GAME 4: BUBBLES */
  .bubbles-header h3 {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .bubbles-header p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: var(--space-sm);
  }

  .bubbles-stage {
    position: relative;
    width: 100%;
    height: 380px;
    background: linear-gradient(180deg, #e8f5f1 0%, #d8eee7 100%);
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    border: 1px solid var(--color-border);
  }

  .bubbles-hint {
    position: absolute;
    top: 10px;
    right: 15px;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  /* Educational Benefits */
  .benefits-section {
    padding: var(--space-xl) 0;
    background: var(--color-primary-xlight);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .benefit-card {
    background: #fff;
    border-radius: var(--radius-md);
    padding: var(--space-md);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
  }

  .benefit-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .benefit-card h3 {
    font-size: 1rem;
    color: var(--color-primary);
    margin-bottom: 0.35rem;
  }

  .benefit-card p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .benefits-grid {
      grid-template-columns: 1fr 1fr;
    }

    .baskets-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .benefits-grid {
      grid-template-columns: 1fr;
    }

    .options-grid {
      grid-template-columns: 1fr;
    }

    .memory-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .memory-card {
      height: 80px;
      font-size: 2rem;
    }
  }
</style>

<script>
  let score = 0;
  let soundEnabled = true;

  // Sound Synth via Web Audio API (No external assets needed)
  function playBeep(type: 'success' | 'click' | 'pop') {
    if (!soundEnabled) return;
    try {
      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioCtx) return;
      const ctx = new AudioCtx();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);

      if (type === 'success') {
        osc.frequency.setValueAtTime(523.25, ctx.currentTime); // C5
        osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.1); // E5
        osc.frequency.setValueAtTime(783.99, ctx.currentTime + 0.2); // G5
        gain.gain.setValueAtTime(0.15, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
        osc.start();
        osc.stop(ctx.currentTime + 0.4);
      } else if (type === 'pop') {
        osc.frequency.setValueAtTime(400, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(80, ctx.currentTime + 0.08);
        gain.gain.setValueAtTime(0.2, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);
        osc.start();
        osc.stop(ctx.currentTime + 0.08);
      } else {
        osc.frequency.setValueAtTime(440, ctx.currentTime);
        gain.gain.setValueAtTime(0.1, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.05);
        osc.start();
        osc.stop(ctx.currentTime + 0.05);
      }
    } catch (e) {
      // Audio not supported or blocked by user gesture
    }
  }

  function addScore() {
    score += 1;
    const scoreEl = document.getElementById('scoreNum');
    if (scoreEl) scoreEl.textContent = String(score);
  }

  // --- TAB NAVIGATION ---
  const tabBtns = document.querySelectorAll('.tab-btn');
  const gameContainers = document.querySelectorAll('.game-container');
  const activeTitle = document.getElementById('activeGameTitle');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('tab-btn--active'));
      btn.classList.add('tab-btn--active');
      const game = btn.getAttribute('data-game');

      gameContainers.forEach(gc => gc.classList.remove('game-container--active'));
      const activeContainer = document.getElementById(`game-${game}`);
      if (activeContainer) activeContainer.classList.add('game-container--active');

      if (activeTitle && btn.textContent) {
        activeTitle.textContent = btn.textContent.trim();
      }
      playBeep('click');
    });
  });

  // Sound Toggle
  const soundBtn = document.getElementById('soundToggle');
  soundBtn?.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    soundBtn.textContent = soundEnabled ? '🔊 الصوت مُفعّل' : '🔇 الصوت مكتوم';
  });

  // --- GAME 1: EMOTIONS MATCHING ---
  const emotionsData = [
    { emoji: '😊', answer: 'سعيد ومسرور', options: ['سعيد ومسرور', 'غاضب جداً', 'خائف', 'نعسان'] },
    { emoji: '😢', answer: 'حزين', options: ['حزين', 'شجاع', 'متحمس', 'ضاحك'] },
    { emoji: '😡', answer: 'غاضب ومنزعج', options: ['هادئ ومسترخي', 'غاضب ومنزعج', 'فرحان', 'جائع'] },
    { emoji: '😲', answer: 'متفاجئ ومندهش', options: ['متفاجئ ومندهش', 'نائم', 'حزين', 'بارد'] },
    { emoji: '🥱', answer: 'متعب ونعسان', options: ['نشيط يجري', 'متعب ونعسان', 'يلعب بالكرة', 'غاضب'] },
    { emoji: '😨', answer: 'خائف وقلق', options: ['خائف وقلق', 'يضحك', 'يشرب ماء', 'سعيد'] }
  ];

  let currentEmotionIndex = 0;

  function loadEmotionQuestion() {
    const data = emotionsData[currentEmotionIndex];
    const emojiDisplay = document.getElementById('currentEmojiDisplay');
    const optionsGrid = document.getElementById('emotionsOptionsGrid');
    const feedback = document.getElementById('emotionsFeedback');

    if (!emojiDisplay || !optionsGrid) return;

    emojiDisplay.textContent = data.emoji;
    optionsGrid.innerHTML = '';
    if (feedback) feedback.style.display = 'none';

    data.options.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'option-btn';
      btn.textContent = opt;
      btn.addEventListener('click', () => checkEmotion(opt, data.answer));
      optionsGrid.appendChild(btn);
    });
  }

  function checkEmotion(selected: string, correct: string) {
    const feedback = document.getElementById('emotionsFeedback');
    if (!feedback) return;

    if (selected === correct) {
      feedback.className = 'feedback-banner feedback-success';
      feedback.textContent = '🌟 إجابة صحيحة وممتازة! أحسنت يا بطل! 👏';
      feedback.style.display = 'block';
      playBeep('success');
      addScore();

      setTimeout(() => {
        currentEmotionIndex = (currentEmotionIndex + 1) % emotionsData.length;
        loadEmotionQuestion();
      }, 1500);
    } else {
      feedback.className = 'feedback-banner feedback-retry';
      feedback.textContent = 'قريب جداً! انظر جيداً إلى الوجه وحاول مرة ثانية 😊';
      feedback.style.display = 'block';
      playBeep('click');
    }
  }

  loadEmotionQuestion();

  // --- GAME 2: MEMORY MATCH ---
  const memoryIcons = ['🍎', '🚗', '🐱', '⚽', '🌟', '🧸'];
  let memoryCards: string[] = [];
  let flippedCards: HTMLElement[] = [];
  let matchedPairs = 0;

  function initMemoryGame() {
    matchedPairs = 0;
    flippedCards = [];
    const grid = document.getElementById('memoryGrid');
    const winMsg = document.getElementById('memoryWin');
    if (!grid) return;

    if (winMsg) winMsg.style.display = 'none';
    grid.innerHTML = '';

    // Duplicate and shuffle
    memoryCards = [...memoryIcons, ...memoryIcons].sort(() => Math.random() - 0.5);

    memoryCards.forEach((icon, index) => {
      const card = document.createElement('div');
      card.className = 'memory-card is-hidden-face';
      card.setAttribute('data-icon', icon);
      card.setAttribute('data-index', String(index));

      const face = document.createElement('span');
      face.className = 'card-face';
      face.textContent = icon;
      card.appendChild(face);

      card.addEventListener('click', () => handleMemoryFlip(card));
      grid.appendChild(card);
    });
  }

  function handleMemoryFlip(card: HTMLElement) {
    if (card.classList.contains('is-flipped') || card.classList.contains('is-matched') || flippedCards.length >= 2) {
      return;
    }

    card.classList.add('is-flipped');
    card.classList.remove('is-hidden-face');
    flippedCards.push(card);
    playBeep('click');

    if (flippedCards.length === 2) {
      const icon1 = flippedCards[0].getAttribute('data-icon');
      const icon2 = flippedCards[1].getAttribute('data-icon');

      if (icon1 === icon2) {
        flippedCards[0].classList.add('is-matched');
        flippedCards[1].classList.add('is-matched');
        flippedCards = [];
        matchedPairs++;
        addScore();
        playBeep('success');

        if (matchedPairs === memoryIcons.length) {
          const winMsg = document.getElementById('memoryWin');
          if (winMsg) winMsg.style.display = 'block';
        }
      } else {
        setTimeout(() => {
          flippedCards.forEach(c => {
            c.classList.remove('is-flipped');
            c.classList.add('is-hidden-face');
          });
          flippedCards = [];
        }, 900);
      }
    }
  }

  document.getElementById('restartMemoryBtn')?.addEventListener('click', initMemoryGame);
  initMemoryGame();

  // --- GAME 3: COLOR SORTING ---
  const sortingItems = [
    { emoji: '🍎', label: 'تفاحة حمراء', color: 'red' },
    { emoji: '🥦', label: 'بروكلي أخضر', color: 'green' },
    { emoji: '🚙', label: 'سيارة زرقاء', color: 'blue' },
    { emoji: '🍋', label: 'ليمونة صفراء', color: 'yellow' },
    { emoji: '🍓', label: 'فراولة حمراء', color: 'red' },
    { emoji: '🐸', label: 'ضفدع أخضر', color: 'green' },
    { emoji: '🌊', label: 'موجة بحر زرقاء', color: 'blue' },
    { emoji: '⭐', label: 'نجمة صفراء لامعة', color: 'yellow' }
  ];

  let currentSortIndex = 0;

  function loadSortingItem() {
    const item = sortingItems[currentSortIndex];
    const display = document.getElementById('sortingCurrentItem');
    const label = document.getElementById('sortingCurrentLabel');
    const feedback = document.getElementById('sortingFeedback');

    if (display) display.textContent = item.emoji;
    if (label) label.textContent = item.label;
    if (feedback) feedback.style.display = 'none';
  }

  document.querySelectorAll('.basket-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetColor = btn.getAttribute('data-color');
      const currentItem = sortingItems[currentSortIndex];
      const feedback = document.getElementById('sortingFeedback');
      if (!feedback) return;

      if (targetColor === currentItem.color) {
        feedback.className = 'feedback-banner feedback-success';
        feedback.textContent = '🎉 صحيح! أحسنت فرز العنصر في مكانه المناسب!';
        feedback.style.display = 'block';
        playBeep('success');
        addScore();

        setTimeout(() => {
          currentSortIndex = (currentSortIndex + 1) % sortingItems.length;
          loadSortingItem();
        }, 1200);
      } else {
        feedback.className = 'feedback-banner feedback-retry';
        feedback.textContent = 'فكر مجدداً: ما هو لون هذا الشيء؟ جرّب سلة أخرى 😊';
        feedback.style.display = 'block';
        playBeep('click');
      }
    });
  });

  loadSortingItem();

  // --- GAME 4: CALMING SENSORY BUBBLES ---
  const stage = document.getElementById('bubblesStage');
  const bubbleColors = ['#a7f3d0', '#bfdbfe', '#fde68a', '#fbcfe8', '#ddd6fe'];

  function createBubble(x?: number, y?: number) {
    if (!stage) return;
    const bubble = document.createElement('div');
    const size = Math.floor(Math.random() * 50) + 40;
    const posX = x !== undefined ? x - size / 2 : Math.random() * (stage.clientWidth - size);
    const posY = y !== undefined ? y - size / 2 : stage.clientHeight - size;

    bubble.style.position = 'absolute';
    bubble.style.width = `${size}px`;
    bubble.style.height = `${size}px`;
    bubble.style.left = `${posX}px`;
    bubble.style.top = `${posY}px`;
    bubble.style.borderRadius = '50%';
    bubble.style.background = bubbleColors[Math.floor(Math.random() * bubbleColors.length)];
    bubble.style.opacity = '0.75';
    bubble.style.boxShadow = 'inset 0 0 10px rgba(255,255,255,0.8), 0 4px 10px rgba(0,0,0,0.06)';
    bubble.style.border = '2px solid rgba(255,255,255,0.6)';
    bubble.style.cursor = 'pointer';
    bubble.style.transition = 'transform 0.15s, opacity 0.15s';
    bubble.style.userSelect = 'none';

    // Float animation
    let currentY = posY;
    const speed = Math.random() * 1.5 + 0.8;
    const floatInterval = setInterval(() => {
      currentY -= speed;
      bubble.style.top = `${currentY}px`;
      if (currentY < -size) {
        clearInterval(floatInterval);
        bubble.remove();
      }
    }, 25);

    // Pop on click or touch
    function popBubble(e: Event) {
      e.stopPropagation();
      clearInterval(floatInterval);
      playBeep('pop');
      addScore();
      bubble.style.transform = 'scale(1.4)';
      bubble.style.opacity = '0';
      setTimeout(() => bubble.remove(), 150);
    }

    bubble.addEventListener('click', popBubble);
    bubble.addEventListener('touchstart', popBubble);

    stage.appendChild(bubble);
  }

  // Periodic gentle bubble spawn
  setInterval(() => {
    const bubblesGame = document.getElementById('game-bubbles');
    if (bubblesGame?.classList.contains('game-container--active')) {
      createBubble();
    }
  }, 900);

  stage?.addEventListener('click', (e: MouseEvent) => {
    const rect = stage.getBoundingClientRect();
    createBubble(e.clientX - rect.left, e.clientY - rect.top);
  });
</script>
