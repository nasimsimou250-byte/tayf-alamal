    font-size: 0.92rem;
  }

  .basket-red { border-color: #e53e3e; color: #e53e3e; }
  .basket-green { border-color: #38a169; color: #38a169; }
  .basket-blue { border-color: #3182ce; color: #3182ce; }
  .basket-yellow { border-color: #d69e2e; color: #d69e2e; }

  /* =========================================
     GAME 4: BUBBLES
     ========================================= */
  .bubbles-header h3 {
    font-size: 1.3rem;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .bubbles-header p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: var(--space-sm);
  }

  .bubbles-stage {
    position: relative;
    width: 100%;
    height: 400px;
    background: linear-gradient(180deg, #e8f5f1 0%, #d8eee7 100%);
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    border: 2px solid var(--color-border);
  }

  .bubbles-hint {
    position: absolute;
    top: 12px;
    right: 15px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
    background: rgba(255, 255, 255, 0.7);
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    pointer-events: none;
  }

  /* Educational Benefits */
  .benefits-section {
    padding: var(--space-xl) 0;
    background: var(--color-primary-xlight);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .benefit-card {
    background: #fff;
    border-radius: var(--radius-md);
    padding: var(--space-md);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
  }

  .benefit-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .benefit-card h3 {
    font-size: 1rem;
    color: var(--color-primary);
    margin-bottom: 0.35rem;
  }

  .benefit-card p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .benefits-grid {
      grid-template-columns: 1fr 1fr;
    }
    .baskets-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .benefits-grid {
      grid-template-columns: 1fr;
    }
    .options-grid {
      grid-template-columns: 1fr;
    }
    .memory-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.65rem;
    }
    .memory-card {
      height: 98px;
      font-size: 2.6rem;
    }
  }
</style>

<script>
  let score = 0;
  let soundEnabled = true;

  // --- SOUND SYNTHESIZER via Web Audio API ---
  function playAudioTone(type: 'success' | 'click' | 'pop' | 'victory') {
    if (!soundEnabled) return;
    try {
      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioCtx) return;
      const ctx = new AudioCtx();

      if (type === 'victory') {
        // Multi-note uplifting chord fanfare
        const fanfareNotes = [
          { f: 523.25, start: 0, dur: 0.16 },    // C5
          { f: 659.25, start: 0.16, dur: 0.16 }, // E5
          { f: 783.99, start: 0.32, dur: 0.16 }, // G5
          { f: 1046.50, start: 0.48, dur: 0.6 }  // C6
        ];
        fanfareNotes.forEach(n => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(n.f, ctx.currentTime + n.start);
          gain.gain.setValueAtTime(0.25, ctx.currentTime + n.start);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + n.start + n.dur);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(ctx.currentTime + n.start);
          osc.stop(ctx.currentTime + n.start + n.dur);
        });
        return;
      }

      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);

      if (type === 'success') {
        osc.frequency.setValueAtTime(523.25, ctx.currentTime);
        osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.1);
        osc.frequency.setValueAtTime(783.99, ctx.currentTime + 0.2);
        gain.gain.setValueAtTime(0.2, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.45);
        osc.start();
        osc.stop(ctx.currentTime + 0.45);
      } else if (type === 'pop') {
        osc.frequency.setValueAtTime(450, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(90, ctx.currentTime + 0.09);
        gain.gain.setValueAtTime(0.25, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.09);
        osc.start();
        osc.stop(ctx.currentTime + 0.09);
      } else {
        osc.frequency.setValueAtTime(440, ctx.currentTime);
        gain.gain.setValueAtTime(0.12, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.06);
        osc.start();
        osc.stop(ctx.currentTime + 0.06);
      }
    } catch (e) {
      // Audio not permitted or failed
    }
  }

  function addScore(points: number = 1) {
    score += points;
    const scoreEl = document.getElementById('scoreNum');
    if (scoreEl) scoreEl.textContent = String(score);
  }

  // --- FULLSCREEN CONFETTI CANNON MOTION ---
  function launchConfettiCannon() {
    const canvas = document.getElementById('confettiCanvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    canvas.style.display = 'block';

    const particles: any[] = [];
    const colors = ['#f4a233', '#1a6b5a', '#38a169', '#3182ce', '#e53e3e', '#805ad5', '#ecc94b', '#ed64a6', '#00b4d8'];

    for (let i = 0; i < 180; i++) {
      particles.push({
        x: canvas.width / 2 + (Math.random() - 0.5) * 300,
        y: canvas.height * 0.45,
        vx: (Math.random() - 0.5) * 22,
        vy: Math.random() * -20 - 6,
        size: Math.random() * 12 + 6,
        color: colors[Math.floor(Math.random() * colors.length)],
        rotation: Math.random() * 360,
        vRot: (Math.random() - 0.5) * 12,
        opacity: 1,
        shape: Math.random() > 0.4 ? 'rect' : 'circle'
      });
    }

    let animationFrame: number;
    const startTime = Date.now();

    function renderConfetti() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const elapsed = Date.now() - startTime;

      particles.forEach(p => {
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.45; // gravity
        p.vx *= 0.98; // air resistance
        p.rotation += p.vRot;
        if (elapsed > 2500) {
          p.opacity -= 0.02;
        }

        ctx.save();
        ctx.globalAlpha = Math.max(0, p.opacity);
        ctx.translate(p.x, p.y);
        ctx.rotate((p.rotation * Math.PI) / 180);
        ctx.fillStyle = p.color;

        if (p.shape === 'rect') {
          ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.7);
        } else {
          ctx.beginPath();
          ctx.arc(0, 0, p.size / 2, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      });

      if (elapsed < 4500) {
        animationFrame = requestAnimationFrame(renderConfetti);
      } else {
        cancelAnimationFrame(animationFrame);
        canvas.style.display = 'none';
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    }

    renderConfetti();
  }

  // --- TAB NAVIGATION ---
  const tabBtns = document.querySelectorAll('.tab-btn');
  const gameContainers = document.querySelectorAll('.game-container');
  const activeTitle = document.getElementById('activeGameTitle');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('tab-btn--active'));
      btn.classList.add('tab-btn--active');
      const game = btn.getAttribute('data-game');

      gameContainers.forEach(gc => gc.classList.remove('game-container--active'));
      const activeContainer = document.getElementById(`game-${game}`);
      if (activeContainer) activeContainer.classList.add('game-container--active');

      if (activeTitle && btn.textContent) {
        activeTitle.textContent = btn.textContent.trim();
      }
      playAudioTone('click');
    });
  });

  // Sound Toggle
  const soundBtn = document.getElementById('soundToggle');
  soundBtn?.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    soundBtn.textContent = soundEnabled ? '🔊 الصوت مُفعّل' : '🔇 الصوت مكتوم';
  });

  // --- GAME 1: EMOTIONS MATCHING (Big & Funnier Buttons) ---
  const emotionsData = [
    {
      emoji: '😊',
      answer: 'سعيد ومسرور',
      options: [
        { text: 'سعيد ومسرور', icon: '😄' },
        { text: 'غاضب جداً', icon: '😤' },
        { text: 'خائف وقلق', icon: '😨' },
        { text: 'نعسان متعب', icon: '🥱' }
      ]
    },
    {
      emoji: '😢',
      answer: 'حزين ويبكي',
      options: [
        { text: 'حزين ويبكي', icon: '💧' },
        { text: 'بطل شجاع', icon: '🦸‍♂️' },
        { text: 'متحمس يركض', icon: '🏃' },
        { text: 'ضاحك فرحان', icon: '🤣' }
      ]
    },
    {
      emoji: '😡',
      answer: 'غاضب ومنزعج',
      options: [
        { text: 'هادئ ومسترخي', icon: '😌' },
        { text: 'غاضب ومنزعج', icon: '🔥' },
        { text: 'فرحان يلعب', icon: '🎈' },
        { text: 'جائع يريد طعام', icon: '🥪' }
      ]
    },
    {
      emoji: '😲',
      answer: 'متفاجئ ومندهش',
      options: [
        { text: 'متفاجئ ومندهش', icon: '✨' },
        { text: 'نائم في السرير', icon: '🛏️' },
        { text: 'حزين صامت', icon: '😶' },
        { text: 'يشرب عصير', icon: '🧃' }
      ]
    },
    {
      emoji: '🥱',
      answer: 'متعب ونعسان',
      options: [
        { text: 'نشيط يقفز', icon: '⚡' },
        { text: 'متعب ونعسان', icon: '💤' },
        { text: 'يلعب بالكرة', icon: '⚽' },
        { text: 'غاضب يصرخ', icon: '🗯️' }
      ]
    },
    {
      emoji: '😨',
      answer: 'خائف من شيء',
      options: [
        { text: 'خائف من شيء', icon: '🫣' },
        { text: 'يضحك بصوت عالٍ', icon: '😄' },
        { text: 'يشرب ماء بارد', icon: '💧' },
        { text: 'سعيد يصفق', icon: '👏' }
      ]
    }
  ];

  let currentEmotionIndex = 0;

  function loadEmotionQuestion() {
    const data = emotionsData[currentEmotionIndex];
    const emojiDisplay = document.getElementById('currentEmojiDisplay');
    const optionsGrid = document.getElementById('emotionsOptionsGrid');
    const feedback = document.getElementById('emotionsFeedback');

    if (!emojiDisplay || !optionsGrid) return;

    emojiDisplay.textContent = data.emoji;
    optionsGrid.innerHTML = '';
    if (feedback) feedback.style.display = 'none';

    data.options.forEach((optObj, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `option-btn option-btn-theme-${idx % 4}`;

      const iconSpan = document.createElement('span');
      iconSpan.className = 'option-emoji-icon';
      iconSpan.textContent = optObj.icon;

      const textSpan = document.createElement('span');
      textSpan.className = 'option-text-label';
      textSpan.textContent = optObj.text;

      btn.appendChild(iconSpan);
      btn.appendChild(textSpan);

      btn.addEventListener('click', () => checkEmotion(optObj.text, data.answer, btn));
      optionsGrid.appendChild(btn);
    });
  }

  function checkEmotion(selected: string, correct: string, clickedBtn: HTMLElement) {
    const feedback = document.getElementById('emotionsFeedback');
    if (!feedback) return;

    if (selected === correct) {
      feedback.className = 'feedback-banner feedback-success';
      feedback.textContent = '🌟 إجابة صحيحة وممتازة! أنت بطل حقيقي! 👏🎉';
      feedback.style.display = 'block';

      clickedBtn.style.transform = 'scale(1.08)';
      clickedBtn.style.borderColor = '#38a169';

      playAudioTone('success');
      addScore(2);

      setTimeout(() => {
        currentEmotionIndex = (currentEmotionIndex + 1) % emotionsData.length;
        loadEmotionQuestion();
      }, 1500);
    } else {
      feedback.className = 'feedback-banner feedback-retry';
      feedback.textContent = 'قريب جداً! انظر جيداً إلى الوجه وحاول مرة ثانية يا بطل 😊';
      feedback.style.display = 'block';

      clickedBtn.classList.add('shake-anim');
      setTimeout(() => clickedBtn.classList.remove('shake-anim'), 500);

      playAudioTone('click');
    }
  }

  loadEmotionQuestion();

  // --- GAME 2: MEMORY MATCH (Bigger Cards & Victory Motion) ---
  const memoryIcons = ['🍎', '🚗', '🐱', '⚽', '🌟', '🧸'];
  let memoryCards: string[] = [];
  let flippedCards: HTMLElement[] = [];
  let matchedPairs = 0;

  function initMemoryGame() {
    matchedPairs = 0;
    flippedCards = [];
    const grid = document.getElementById('memoryGrid');
    const modal = document.getElementById('celebrationModal');
    if (!grid) return;
    if (modal) modal.style.display = 'none';

    grid.innerHTML = '';

    // Shuffle 6 pairs = 12 cards
    memoryCards = [...memoryIcons, ...memoryIcons].sort(() => Math.random() - 0.5);

    memoryCards.forEach((icon, index) => {
      const card = document.createElement('div');
      card.className = 'memory-card is-hidden-face';
      card.setAttribute('data-icon', icon);
      card.setAttribute('data-index', String(index));

      const face = document.createElement('span');
      face.className = 'card-face';
      face.textContent = icon;
      card.appendChild(face);

      card.addEventListener('click', () => handleMemoryFlip(card));
      grid.appendChild(card);
    });
  }

  function handleMemoryFlip(card: HTMLElement) {
    if (card.classList.contains('is-flipped') || card.classList.contains('is-matched') || flippedCards.length >= 2) {
      return;
    }

    card.classList.add('is-flipped');
    card.classList.remove('is-hidden-face');
    flippedCards.push(card);
    playAudioTone('click');

    if (flippedCards.length === 2) {
      const icon1 = flippedCards[0].getAttribute('data-icon');
      const icon2 = flippedCards[1].getAttribute('data-icon');

      if (icon1 === icon2) {
        flippedCards[0].classList.add('is-matched');
        flippedCards[1].classList.add('is-matched');
        flippedCards = [];
        matchedPairs++;
        addScore(3);
        playAudioTone('success');

        // Check if game is completely finished
        if (matchedPairs === memoryIcons.length) {
          setTimeout(() => {
            // 1. Play grand fanfare
            playAudioTone('victory');
            // 2. Launch full-screen confetti explosion
            launchConfettiCannon();
            // 3. Show celebration modal
            const modal = document.getElementById('celebrationModal');
            if (modal) modal.style.display = 'flex';
          }, 600);
        }
      } else {
        setTimeout(() => {
          flippedCards.forEach(c => {
            c.classList.remove('is-flipped');
            c.classList.add('is-hidden-face');
          });
          flippedCards = [];
        }, 850);
      }
    }
  }

  document.getElementById('modalRestartBtn')?.addEventListener('click', () => {
    const modal = document.getElementById('celebrationModal');
    if (modal) modal.style.display = 'none';
    initMemoryGame();
  });

  document.getElementById('restartMemoryBtnManual')?.addEventListener('click', initMemoryGame);

  initMemoryGame();

  // --- GAME 3: COLOR SORTING ---
  const sortingItems = [
    { emoji: '🍎', label: 'تفاحة حمراء شهية', color: 'red' },
    { emoji: '🥦', label: 'بروكلي أخضر صحي', color: 'green' },
    { emoji: '🚙', label: 'سيارة زرقاء سريعة', color: 'blue' },
    { emoji: '🍋', label: 'ليمونة صفراء منعشة', color: 'yellow' },
    { emoji: '🍓', label: 'فراولة حمراء لذيذة', color: 'red' },
    { emoji: '🐸', label: 'ضفدع أخضر يقفز', color: 'green' },
    { emoji: '🌊', label: 'موجة بحر زرقاء', color: 'blue' },
    { emoji: '⭐', label: 'نجمة صفراء لامعة', color: 'yellow' }
  ];

  let currentSortIndex = 0;

  function loadSortingItem() {
    const item = sortingItems[currentSortIndex];
    const display = document.getElementById('sortingCurrentItem');
    const label = document.getElementById('sortingCurrentLabel');
    const feedback = document.getElementById('sortingFeedback');

    if (display) display.textContent = item.emoji;
    if (label) label.textContent = item.label;
    if (feedback) feedback.style.display = 'none';
  }

  document.querySelectorAll('.basket-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetColor = btn.getAttribute('data-color');
      const currentItem = sortingItems[currentSortIndex];
      const feedback = document.getElementById('sortingFeedback');
      if (!feedback) return;

      if (targetColor === currentItem.color) {
        feedback.className = 'feedback-banner feedback-success';
        feedback.textContent = '🎉 رائع جداً! وضعت العنصر في السلة الصحيحة!';
        feedback.style.display = 'block';
        playAudioTone('success');
        addScore(2);

        setTimeout(() => {
          currentSortIndex = (currentSortIndex + 1) % sortingItems.length;
          loadSortingItem();
        }, 1200);
      } else {
        feedback.className = 'feedback-banner feedback-retry';
        feedback.textContent = 'فكر ثانية يا بطل: ما هو لون هذا الشيء؟ جرّب سلة أخرى 😊';
        feedback.style.display = 'block';
        playAudioTone('click');
      }
    });
  });

  loadSortingItem();

  // --- GAME 4: CALMING SENSORY BUBBLES ---
  const stage = document.getElementById('bubblesStage');
  const bubbleColors = ['#a7f3d0', '#bfdbfe', '#fde68a', '#fbcfe8', '#ddd6fe'];

  function createBubble(x?: number, y?: number) {
    if (!stage) return;
    const bubble = document.createElement('div');
    const size = Math.floor(Math.random() * 55) + 45;
    const posX = x !== undefined ? x - size / 2 : Math.random() * (stage.clientWidth - size);
    const posY = y !== undefined ? y - size / 2 : stage.clientHeight - size;

    bubble.style.position = 'absolute';
    bubble.style.width = `${size}px`;
    bubble.style.height = `${size}px`;
    bubble.style.left = `${posX}px`;
    bubble.style.top = `${posY}px`;
    bubble.style.borderRadius = '50%';
    bubble.style.background = bubbleColors[Math.floor(Math.random() * bubbleColors.length)];
    bubble.style.opacity = '0.78';
    bubble.style.boxShadow = 'inset 0 0 14px rgba(255,255,255,0.9), 0 6px 14px rgba(0,0,0,0.08)';
    bubble.style.border = '2.5px solid rgba(255,255,255,0.8)';
    bubble.style.cursor = 'pointer';
    bubble.style.transition = 'transform 0.15s, opacity 0.15s';
    bubble.style.userSelect = 'none';

    let currentY = posY;
    const speed = Math.random() * 1.5 + 0.8;
    const floatInterval = setInterval(() => {
      currentY -= speed;
      bubble.style.top = `${currentY}px`;
      if (currentY < -size) {
        clearInterval(floatInterval);
        bubble.remove();
      }
    }, 25);

    function popBubble(e: Event) {
      e.stopPropagation();
      clearInterval(floatInterval);
      playAudioTone('pop');
      addScore(1);
      bubble.style.transform = 'scale(1.4)';
      bubble.style.opacity = '0';
      setTimeout(() => bubble.remove(), 150);
    }

    bubble.addEventListener('click', popBubble);
    bubble.addEventListener('touchstart', popBubble);

    stage.appendChild(bubble);
  }

  setInterval(() => {
    const bubblesGame = document.getElementById('game-bubbles');
    if (bubblesGame?.classList.contains('game-container--active')) {
      createBubble();
    }
  }, 850);

  stage?.addEventListener('click', (e: MouseEvent) => {
    const rect = stage.getBoundingClientRect();
    createBubble(e.clientX - rect.left, e.clientY - rect.top);
  });
</script>
