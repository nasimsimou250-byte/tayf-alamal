---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="دليل أولياء الأمور لتوحد الأطفال"
  description="موقع طيف الأمل — دليلك الموثوق لدعم طفلك في رحلة طيف التوحد. أدوات تعليمية، مقالات علمية مبسطة، وموارد عملية للأسر العربية."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero__inner">
        <div class="hero__content">
          <span class="badge">دليل علمي مبسط للأسرة العربية</span>
          <h1 class="hero__title">
            رحلتك مع طفلك<br />
            <em>تبدأ بالفهم</em>
          </h1>
          <p class="hero__subtitle">
            طيف الأمل هو دليلك الموثوق باللغة العربية لدعم طفلك ذوي طيف التوحد.
            نقدم لك أدوات تعليمية عملية، إرشادات علمية مبسطة، وموارد تساعدك كل يوم.
          </p>
          <div class="hero__cta">
            <a href="/articles/" class="btn btn--primary">تصفح المقالات</a>
            <a href="/tools/" class="btn btn--outline">الأدوات التعليمية</a>
          </div>
          <div class="hero__trust">
            <span>✅ محتوى علمي موثوق</span>
            <span>✅ مراجعة متخصصين</span>
            <span>✅ مجاني تماماً</span>
          </div>
        </div>
        <div class="hero__visual" aria-hidden="true">
          <div class="hero__card hero__card--1">
            <div class="hero__card-icon">🧩</div>
            <div>بطاقات بصرية تفاعلية</div>
          </div>
          <div class="hero__card hero__card--2">
            <div class="hero__card-icon">📅</div>
            <div>جداول يومية منظمة</div>
          </div>
          <div class="hero__card hero__card--3">
            <div class="hero__card-icon">📖</div>
            <div>قصص اجتماعية عربية</div>
          </div>
          <div class="hero__card hero__card--4">
            <div class="hero__card-icon">🎯</div>
            <div>تقنيات ABA في البيت</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AD SLOT TOP -->
  <div class="container">
    <div class="ad-slot" aria-label="إعلان">
      <!-- [AD:TOP-BANNER] Google AdSense -->
      <ins class="adsbygoogle"
           style="display:block;width:100%;min-height:90px;"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="XXXXXXXXXX"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>
  </div>

  <!-- FEATURES / WHY US -->
  <section class="features">
    <div class="container">
      <div class="section-header">
        <span class="badge">لماذا طيف الأمل؟</span>
        <h2 class="section-title">كل ما يحتاجه ولي الأمر في مكان واحد</h2>
        <p class="section-subtitle">محتوى مدروس، مُصمَّم خصيصاً للأسرة العربية</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-card__icon">🔬</div>
          <h3>موثوق علمياً</h3>
          <p>جميع المحتوى مبني على أبحاث علمية محكّمة وإرشادات منظمات التوحد الدولية.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card__icon">🗣️</div>
          <h3>بالعربية الواضحة</h3>
          <p>نُترجم المصطلحات الطبية المعقدة إلى لغة عربية سهلة يفهمها كل أحد.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card__icon">🛠️</div>
          <h3>أدوات عملية جاهزة</h3>
          <p>بطاقات بصرية، جداول يومية، وقصص اجتماعية جاهزة للتطبيق مباشرة في المنزل.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card__icon">❤️</div>
          <h3>دعم مستمر للأسرة</h3>
          <p>نفهم تحديات الأسرة العربية ونقدم إرشادات واقعية تناسب ثقافتنا وبيئتنا.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ARTICLES PREVIEW -->
  <section class="articles-preview">
    <div class="container">
      <div class="section-header">
        <span class="badge">آخر المقالات</span>
        <h2 class="section-title">مقالات لكل رحلة</h2>
      </div>
      <div class="articles-grid">
        <article class="article-card article-card--featured">
          <div class="article-card__badge">دليل شامل</div>
          <h3><a href="/articles/autism-levels-diagnosis/">مستويات طيف التوحد والتشخيص المبكر: دليل الأسرة الكامل</a></h3>
          <p>تعرف على الفرق بين مستويات طيف التوحد الثلاثة، وكيف يتم التشخيص، وما هي العلامات التي يجب أن تنتبه إليها مبكراً.</p>
          <div class="article-card__meta">
            <span>⏱ 8 دقائق قراءة</span>
            <a href="/articles/autism-levels-diagnosis/" class="article-card__link">اقرأ المزيد ←</a>
          </div>
        </article>
        <article class="article-card">
          <div class="article-card__badge">تقنيات عملية</div>
          <h3><a href="/articles/aba-therapy-home/">تطبيق تقنيات ABA في المنزل بخطوات بسيطة</a></h3>
          <p>دليل عملي لأولياء الأمور لتطبيق أسس العلاج السلوكي التطبيقي في روتين يومي المنزل.</p>
          <div class="article-card__meta">
            <span>⏱ 10 دقائق قراءة</span>
            <a href="/articles/aba-therapy-home/" class="article-card__link">اقرأ المزيد ←</a>
          </div>
        </article>
        <article class="article-card">
          <div class="article-card__badge">أدوات مجانية</div>
          <h3><a href="/articles/visual-schedules-flashcards/">الجداول البصرية والبطاقات: كيف تُنظم يوم طفلك</a></h3>
          <p>الأدوات البصرية هي أقوى وسيلة لمساعدة طفل التوحد على فهم روتينه وتقليل القلق اليومي.</p>
          <div class="article-card__meta">
            <span>⏱ 7 دقائق قراءة</span>
            <a href="/articles/visual-schedules-flashcards/" class="article-card__link">اقرأ المزيد ←</a>
          </div>
        </article>
        <article class="article-card">
          <div class="article-card__badge">تواصل اجتماعي</div>
          <h3><a href="/articles/social-stories/">القصص الاجتماعية: نافذة طفلك على العالم</a></h3>
          <p>كيف تكتب وتستخدم القصص الاجتماعية لمساعدة طفلك على تعلم المواقف الاجتماعية اليومية.</p>
          <div class="article-card__meta">
            <span>⏱ 6 دقائق قراءة</span>
            <a href="/articles/social-stories/" class="article-card__link">اقرأ المزيد ←</a>
          </div>
        </article>
        <article class="article-card">
          <div class="article-card__badge">موارد مُختارة</div>
          <h3><a href="/articles/apps-books/">أفضل التطبيقات والكتب لأطفال طيف التوحد</a></h3>
          <p>قائمة منتقاة بعناية من أفضل التطبيقات التعليمية والكتب المُوصى بها من متخصصين.</p>
          <div class="article-card__meta">
            <span>⏱ 9 دقائق قراءة</span>
            <a href="/articles/apps-books/" class="article-card__link">اقرأ المزيد ←</a>
          </div>
        </article>
        <article class="article-card">
          <div class="article-card__badge">أسئلة وأجوبة</div>
          <h3><a href="/articles/autism-faq/">أسئلة شائعة يسألها الآباء العرب عن التوحد</a></h3>
          <p>إجابات واضحة وصادقة على أكثر الأسئلة التي تشغل بال الأسر العربية بشأن طيف التوحد.</p>
          <div class="article-card__meta">
            <span>⏱ 12 دقائق قراءة</span>
            <a href="/articles/autism-faq/" class="article-card__link">اقرأ المزيد ←</a>
          </div>
        </article>
      </div>
      <div style="text-align:center; margin-top: var(--space-lg);">
        <a href="/articles/" class="btn btn--primary">جميع المقالات</a>
      </div>
    </div>
  </section>

  <!-- AD SLOT IN-ARTICLE -->
  <div class="container">
    <div class="ad-slot">
      <!-- [AD:IN-ARTICLE] Google AdSense -->
      <ins class="adsbygoogle"
           style="display:block;text-align:center;"
           data-ad-layout="in-article"
           data-ad-format="fluid"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="XXXXXXXXXX"></ins>
    </div>
  </div>

  <!-- TOOLS CTA -->
  <section class="tools-cta">
    <div class="container">
      <div class="tools-cta__inner">
        <div>
          <span class="badge">مجاني للتحميل</span>
          <h2>أدوات تعليمية جاهزة الاستخدام</h2>
          <p>جداول يومية بصرية، بطاقات تعليمية، وقصص اجتماعية — كلها مجانية ومُصممة خصيصاً لطفلك.</p>
          <a href="/tools/" class="btn btn--primary" style="margin-top:var(--space-sm)">تصفح الأدوات</a>
        </div>
        <div class="tools-cta__icons" aria-hidden="true">
          <span>📅</span><span>🧩</span><span>📖</span><span>🎯</span>
        </div>
      </div>
    </div>
  </section>

  <!-- EXPERT NOTE -->
  <section class="expert-note">
    <div class="container--narrow">
      <div class="info-box info-box--accent">
        <strong>⚕️ ملاحظة طبية مهمة:</strong> المحتوى على هذا الموقع يهدف للتثقيف والتوعية فقط،
        ولا يُغني عن الاستشارة الطبية والنفسية المتخصصة. إذا كنت تشك في وجود طيف التوحد لدى طفلك،
        يُرجى التواصل مع طبيب أو متخصص مؤهل في أقرب وقت.
      </div>
    </div>
  </section>

  <!-- AD SLOT BOTTOM -->
  <div class="container">
    <div class="ad-slot">
      <!-- [AD:MULTIPLEX] Google AdSense -->
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-format="autorelaxed"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="XXXXXXXXXX"></ins>
    </div>
  </div>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    background: linear-gradient(135deg, var(--color-primary-xlight) 0%, #fff 60%);
    padding: var(--space-xl) 0 var(--space-lg);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-lg);
    align-items: center;
  }

  .hero__title {
    font-size: clamp(1.65rem, 3.8vw, 2.6rem);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
    line-height: 1.3;
  }

  .hero__title em {
    font-style: normal;
    color: var(--color-primary);
    position: relative;
    display: inline-block;
  }

  .hero__title em::after {
    content: '';
    position: absolute;
    bottom: 2px;
    right: 0;
    left: 0;
    height: 3px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  .hero__subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--space-md);
  }

  .hero__cta {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .hero__trust {
    display: flex;
    gap: var(--space-md);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .hero__visual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .hero__card {
    background: var(--color-surface);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    box-shadow: var(--shadow-md);
    text-align: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-text);
    transition: transform 0.3s ease;
  }

  .hero__card:hover {
    transform: translateY(-4px);
  }

  .hero__card--1 { transform: translateY(-8px); }
  .hero__card--2 { transform: translateY(4px); }
  .hero__card--3 { transform: translateY(8px); }
  .hero__card--4 { transform: translateY(-4px); }

  .hero__card-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  /* FEATURES */
  .features {
    padding: var(--space-xl) 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .section-subtitle {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-top: var(--space-xs);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .feature-card {
    background: var(--color-surface);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .feature-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }

  .feature-card__icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-sm);
  }

  .feature-card h3 {
    font-size: 1.1rem;
    margin-bottom: var(--space-xs);
    color: var(--color-primary);
  }

  .feature-card p {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  /* ARTICLES */
  .articles-preview {
    padding: var(--space-xl) 0;
    background: var(--color-primary-xlight);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .article-card {
    background: var(--color-surface);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    transition: all 0.25s ease;
  }

  .article-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .article-card--featured {
    grid-column: span 3;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: #fff;
    border: none;
  }

  .article-card--featured h3 a,
  .article-card--featured p {
    color: #fff;
  }

  .article-card--featured .article-card__meta {
    border-top-color: rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.8);
  }

  .article-card--featured .article-card__link {
    color: var(--color-accent);
  }

  .article-card__badge {
    display: inline-block;
    background: var(--color-primary-xlight);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 100px;
    margin-bottom: 0.75rem;
  }

  .article-card--featured .article-card__badge {
    background: var(--color-accent);
    color: #fff;
  }

  .article-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }

  .article-card h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .article-card h3 a:hover {
    color: var(--color-primary);
  }

  .article-card p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .article-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding-top: 0.65rem;
    margin-top: auto;
  }

  .article-card__link {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }

  /* TOOLS CTA */
  .tools-cta {
    padding: var(--space-xl) 0;
  }

  .tools-cta__inner {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .tools-cta__inner h2 {
    font-size: 1.75rem;
    margin-bottom: var(--space-xs);
    color: var(--color-primary);
  }

  .tools-cta__inner p {
    color: var(--color-text-muted);
  }

  .tools-cta__icons {
    display: flex;
    gap: var(--space-sm);
    font-size: 3rem;
    flex-shrink: 0;
  }

  .expert-note {
    padding-bottom: var(--space-lg);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero__cta {
      justify-content: center;
    }
    .hero__trust {
      justify-content: center;
    }
    .hero__visual {
      display: none;
    }
    .features-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-sm);
    }
    .articles-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-sm);
    }
    .article-card--featured {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
    .articles-grid {
      grid-template-columns: 1fr;
    }
    .article-card--featured {
      grid-column: span 1;
    }
    .tools-cta__inner {
      flex-direction: column;
      text-align: center;
      padding: var(--space-md);
      gap: var(--space-md);
    }
    .tools-cta__icons {
      font-size: 2.2rem;
    }
    .hero__cta {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__cta .btn {
      width: 100%;
    }
    .hero__trust {
      flex-direction: column;
      gap: 0.35rem;
      align-items: center;
    }
  }
</style>
