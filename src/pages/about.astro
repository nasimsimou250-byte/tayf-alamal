---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'من نحن';
const description = 'تعرف على فريق طيف الأمل ومهمتنا في دعم الأسر العربية التي لديها أطفال بطيف التوحد.';
---

<BaseLayout title={title} description={description}>

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container--narrow">
      <span class="badge">تعرف علينا</span>
      <h1 class="page-hero__title">من نحن</h1>
      <p class="page-hero__lead">
        طيف الأمل هو مشروع تعليمي عربي متخصص يُقدّم محتوى علمياً مبسطاً حول طيف التوحد،
        موجّهاً للآباء والأمهات والمربّين الذين يسعون إلى دعم أطفالهم بأفضل الأساليب
        وأحدث الممارسات المستندة إلى الأدلة العلمية.
      </p>
    </div>
  </section>

  <!-- Ad Slot Top -->
  <div class="container--narrow">
    <div class="ad-slot">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="1111111111"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>
  </div>

  <!-- Mission Section -->
  <section class="content-section">
    <div class="container--narrow">
      <div class="section-intro">
        <span class="badge">رسالتنا</span>
        <h2 class="section-title">لماذا أنشأنا طيف الأمل؟</h2>
      </div>
      <div class="prose">
        <p>
          في عالم تتسارع فيه المعلومات وتتشابك فيه المصادر، يجد كثير من الآباء العرب أنفسهم
          أمام تحدٍّ مزدوج: تشخيص طفل على طيف التوحد من جهة، والبحث عن مصادر معلومات موثوقة
          باللغة العربية من جهة أخرى. وُلد طيف الأمل من رحم هذه الحاجة الحقيقية، ليكون جسراً
          يربط الأسر العربية بأحدث المعارف العلمية في مجال التوحد.
        </p>
        <p>
          لاحظنا أن معظم المحتوى العلمي المتعلق بطيف التوحد متاح بالإنجليزية أو الفرنسية،
          بينما يُعاني الآباء العرب من شُحّ حقيقي في المحتوى العربي المتخصص والموثوق. ما هو
          متاح غالباً إما مترجم ترجمة آلية ركيكة، أو مجتزأ من سياقه العلمي، أو يفتقر إلى
          المراجعة المتخصصة. نحن هنا لسدّ هذه الفجوة.
        </p>
        <p>
          انطلقنا من قناعة راسخة مفادها أن كل طفل على الطيف يستحق أبوين مسلّحين بالمعرفة
          والأدوات الصحيحة. والمعرفة — عندما تُقدَّم بوضوح وبلغة الأم — تُحدث فارقاً حقيقياً
          في حياة الأسر وتؤثر إيجاباً في مسيرة كل طفل.
        </p>

        <div class="info-box">
          <h3>🎯 مهمتنا في جملة واحدة</h3>
          <p style="margin-bottom:0; font-size:1.1rem; font-weight:600;">
            تمكين الأسر العربية من أدوات المعرفة العلمية المبسطة لدعم أطفالهم على طيف التوحد،
            وتحسين جودة حياتهم اليومية.
          </p>
        </div>

        <h2>ما الذي يميّز طيف الأمل؟</h2>
        <p>
          نحن لسنا منصة طبية ولا نستهدف تقديم تشخيصات أو وصف علاجات. نحن بالأساس منصة
          تعليمية تؤمن بأن الأهل هم الشريك الأول والأكثر تأثيراً في رحلة طفلهم. لذلك نركّز على:
        </p>
        <ul>
          <li><strong>المحتوى العلمي المراجَع:</strong> كل مقال نكتبه يستند إلى دراسات ومراجع علمية معترف بها دولياً.</li>
          <li><strong>اللغة المُيسَّرة:</strong> نترجم المصطلحات التقنية إلى لغة عربية سلسة يفهمها كل أب وكل أم.</li>
          <li><strong>الأدوات التطبيقية:</strong> نوفّر جداول بصرية وبطاقات تعليمية وقصصاً اجتماعية يمكن استخدامها فوراً في المنزل.</li>
          <li><strong>التحديث المستمر:</strong> نتابع أحدث الأبحاث ونُحدِّث محتوانا بانتظام لضمان دقته.</li>
          <li><strong>الشمولية الجغرافية:</strong> نكتب لكل الأسر العربية من المحيط إلى الخليج، مراعين التنوع الثقافي والاجتماعي.</li>
        </ul>

        <h2>التزامنا بالدقة والمصداقية</h2>
        <p>
          في مجال حساس كطيف التوحد، المعلومات الخاطئة لها ثمن حقيقي يدفعه الأطفال وأسرهم.
          لذلك نلتزم بمعايير صارمة في كتابة المحتوى وتحريره:
        </p>
        <ul>
          <li>نستشهد بدراسات منشورة في مجلات علمية محكّمة كـ <em>Journal of Autism and Developmental Disorders</em> و<em>Autism Research</em>.</li>
          <li>نُراجع كل مقال قبل نشره مع متخصص في التربية الخاصة أو علم النفس.</li>
          <li>نُفرّق بوضوح بين ما هو ثابت علمياً وما هو قيد البحث أو الجدل.</li>
          <li>نرفض رفضاً قاطعاً المعلومات المضلّلة أو العلاجات غير المعتمدة التي تُروَّج أحياناً على الإنترنت.</li>
          <li>نُذكّر دائماً بأن كل طفل فريد ولا بديل عن تشخيص وخطة تدخل فردية من متخصص مُرخّص.</li>
        </ul>

        <h2>ما الذي تجده في موقعنا؟</h2>
        <p>
          يضم طيف الأمل ثلاثة أقسام رئيسية مُصمَّمة لتلبية احتياجاتك في كل مرحلة:
        </p>
        <div class="offers-grid">
          <div class="offer-card">
            <div class="offer-card__icon">📚</div>
            <h3>المقالات العلمية</h3>
            <p>مقالات مُعمَّقة تغطي التشخيص، ومستويات الطيف، وأساليب التدخل، والأدوات التعليمية، والأسئلة الأكثر شيوعاً.</p>
          </div>
          <div class="offer-card">
            <div class="offer-card__icon">🛠️</div>
            <h3>الأدوات التعليمية</h3>
            <p>قوالب جاهزة للتحميل تشمل الجداول البصرية، وبطاقات التواصل، والقصص الاجتماعية، وجداول الروتين اليومي.</p>
          </div>
          <div class="offer-card">
            <div class="offer-card__icon">💬</div>
            <h3>الدعم المجتمعي</h3>
            <p>مساحة للتواصل وطرح الأسئلة والحصول على إرشادات عامة من فريق متخصص يفهم احتياجاتك.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ad Slot Mid -->
  <div class="container--narrow">
    <div class="ad-slot">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="2222222222"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>
  </div>

  <!-- Author Bio -->
  <section class="content-section">
    <div class="container--narrow">
      <span class="badge">فريقنا</span>
      <h2 class="section-title">من وراء المحتوى؟</h2>
      <p class="section-lead">
        يُشرف على محتوى طيف الأمل فريق من المتخصصين والمهتمين بمجال التربية الخاصة،
        في مقدمتهم:
      </p>

      <div class="author-card">
        <div class="author-card__avatar">
          <span class="author-card__initials">د. ف</span>
        </div>
        <div class="author-card__info">
          <h3 class="author-card__name">د. فاطمة الزهراء</h3>
          <p class="author-card__title">دكتوراه في علم النفس التربوي — متخصصة في التوحد واضطرابات النمو</p>
          <div class="author-card__bio">
            <p>
              تحمل الدكتورة فاطمة الزهراء شهادة الدكتوراه في علم النفس التربوي مع تخصص دقيق
              في اضطرابات طيف التوحد من جامعة القاهرة، إضافة إلى شهادة متقدمة في تحليل السلوك
              التطبيقي (ABA) من معهد معتمد دولياً.
            </p>
            <p>
              خلال مسيرتها المهنية التي تمتد لأكثر من <strong>خمس عشرة سنة</strong>، عملت
              الدكتورة فاطمة مع مئات الأطفال وأسرهم في مراكز متخصصة بمصر والسعودية والإمارات.
              أشرفت على تطوير مناهج تعليمية مُكيَّفة لأطفال الطيف، وقدّمت دورات تدريبية للمعلمين
              والأهل في أكثر من عشرين مؤسسة تعليمية وعلاجية.
            </p>
            <p>
              تؤمن الدكتورة فاطمة بأن الأب والأم — حين يمتلكان الأدوات الصحيحة — يُصبحان
              المعالجَين الأكثر تأثيراً في حياة طفلهما. انطلاقاً من هذه القناعة، أسست طيف الأمل
              لتكون منارة معرفية حقيقية للأسر العربية.
            </p>
            <div class="author-card__credentials">
              <span class="credential-badge">دكتوراه علم النفس التربوي</span>
              <span class="credential-badge">معتمدة في تحليل السلوك (ABA)</span>
              <span class="credential-badge">+15 سنة خبرة</span>
              <span class="credential-badge">200+ أسرة مدعومة</span>
            </div>
          </div>
        </div>
      </div>

      <div class="prose" style="margin-top: var(--space-lg);">
        <h2>فريق التحرير والمراجعة</h2>
        <p>
          إلى جانب الدكتورة فاطمة، يضم طيف الأمل فريقاً من المتعاونين المتخصصين الذين يُشاركون
          في كتابة المقالات ومراجعتها:
        </p>
        <ul>
          <li><strong>أخصائيو التربية الخاصة:</strong> يُقدّمون مراجعات تخصصية لضمان دقة المحتوى التربوي.</li>
          <li><strong>معالجو اللغة والكلام:</strong> يُساهمون في المقالات المتعلقة بتطوير التواصل.</li>
          <li><strong>أهل من مجتمع الطيف:</strong> يُشاركون تجاربهم الحقيقية لإثراء المحتوى بصوت الأسر.</li>
          <li><strong>محررون لغويون:</strong> يضمنون سلامة اللغة العربية ووضوح الأسلوب.</li>
        </ul>

        <h2>قيمنا الجوهرية</h2>
        <p>نبني طيف الأمل على خمس قيم لا نتنازل عنها:</p>
        <ol>
          <li><strong>الدقة العلمية:</strong> لا ننشر ما لا يستند إلى دليل علمي موثوق.</li>
          <li><strong>الاحترام والتعاطف:</strong> نتحدث إلى الأهل بوصفهم شركاء لا مستمعين.</li>
          <li><strong>الشفافية:</strong> نُفصح عن مصادرنا ونعترف بحدود معرفتنا.</li>
          <li><strong>الشمولية:</strong> نحترم تنوع الطيف وتنوع الأسر.</li>
          <li><strong>الاستمرارية:</strong> نلتزم بتحديث المحتوى ومواكبة الأبحاث الجديدة.</li>
        </ol>

        <div class="info-box info-box--accent">
          <h3>📬 تواصل معنا</h3>
          <p>هل لديك سؤال؟ اقتراح؟ تجربة تودّ مشاركتها؟ باب طيف الأمل مفتوح دائماً.</p>
          <a href="/contact/" class="btn btn--primary" style="margin-top:0.75rem; display:inline-block;">
            تواصل مع الفريق
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Ad Slot Bottom -->
  <div class="container--narrow">
    <div class="ad-slot">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="3333333333"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>
  </div>

</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, #145749 100%);
    color: #fff;
    padding: var(--space-xl) 0;
    text-align: center;
  }

  .page-hero .badge {
    background: rgba(255,255,255,0.2);
    color: #fff;
  }

  .page-hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    color: #fff;
    margin: var(--space-xs) 0;
  }

  .page-hero__lead {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.88);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.9;
  }

  .content-section {
    padding: var(--space-xl) 0;
  }

  .section-intro {
    margin-bottom: var(--space-md);
  }

  .section-lead {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .prose h2 {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .prose h3 {
    font-size: 1.15rem;
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  .prose ul, .prose ol {
    margin-bottom: var(--space-sm);
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  /* Offers Grid */
  .offers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .offer-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    text-align: center;
    box-shadow: var(--shadow-sm);
  }

  .offer-card__icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-xs);
  }

  .offer-card h3 {
    font-size: 1.05rem;
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
  }

  .offer-card p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0;
  }

  /* Author Card */
  .author-card {
    display: flex;
    gap: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    box-shadow: var(--shadow-md);
    margin-top: var(--space-md);
  }

  .author-card__avatar {
    flex-shrink: 0;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-card__initials {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 900;
    color: #fff;
  }

  .author-card__name {
    font-size: 1.4rem;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .author-card__title {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: var(--space-sm);
  }

  .author-card__bio p {
    font-size: 0.97rem;
    line-height: 1.85;
    margin-bottom: 0.75rem;
  }

  .author-card__credentials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-sm);
  }

  .credential-badge {
    background: var(--color-primary-xlight);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.3rem 0.8rem;
    border-radius: 100px;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .offers-grid {
      grid-template-columns: 1fr;
    }

    .author-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .author-card__credentials {
      justify-content: center;
    }
  }
</style>
