---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'إخلاء المسؤولية';
const description = 'إخلاء مسؤولية موقع طيف الأمل — المحتوى لأغراض تعليمية فقط وليس بديلاً عن الاستشارة الطبية المتخصصة.';
const lastUpdated = 'سبتمبر 2026';
---

<BaseLayout title={title} description={description}>

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container--narrow">
      <span class="badge">قانوني</span>
      <h1 class="page-hero__title">إخلاء المسؤولية</h1>
      <p class="page-hero__lead">
        يُرجى قراءة هذا الإشعار القانوني بعناية قبل الاستناد إلى أي محتوى
        منشور على موقع طيف الأمل.
      </p>
      <p class="last-updated">آخر تحديث: {lastUpdated}</p>
    </div>
  </section>

  <!-- Ad Slot Top -->
  <div class="container--narrow">
    <div class="ad-slot">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="9191919191"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>
  </div>

  <!-- Main Alert Box -->
  <section class="disclaimer-section">
    <div class="container--narrow">
      <div class="main-alert">
        <div class="main-alert__icon">⚕️</div>
        <div class="main-alert__content">
          <h2>تنبيه طبي مهم جداً</h2>
          <p>
            المحتوى المنشور على موقع طيف الأمل هو لأغراض <strong>تعليمية وتوعوية فقط</strong>،
            ولا يُعدّ بأي حال من الأحوال بديلاً عن التشخيص الطبي أو الاستشارة المتخصصة
            أو خطط التدخل الفردية المقدَّمة من متخصصين مُرخَّصين.
          </p>
          <p style="margin-bottom:0;">
            إذا كنت تشك في أن طفلك قد يكون على طيف التوحد، أو إذا كان لديك أي مخاوف
            تتعلق بنموه وتطوره، <strong>يُرجى التواصل فوراً مع طبيب أطفال متخصص</strong>.
          </p>
        </div>
      </div>

      <div class="disclaimer-body">

        <div class="disclaimer-block">
          <h2>1. الطبيعة التعليمية للمحتوى</h2>
          <p>
            جميع المقالات والأدوات والموارد المتاحة على موقع طيف الأمل مُعدَّة لأغراض التثقيف
            والتوعية العامة. هدفنا مساعدة الآباء والمربّين على فهم طيف التوحد بصورة أعمق
            وبلغة عربية ميسّرة، وليس تقديم أي نوع من الخدمات الطبية أو العلاجية أو النفسية.
          </p>
          <p>
            المعلومات الواردة في محتوانا مستمدة من أبحاث علمية منشورة وكتب متخصصة ومصادر
            موثوقة، غير أن هذا لا يجعلها بديلاً عن التقييم المهني لكل حالة على حدة.
            طيف التوحد طيفٌ واسع ومتعدد الأوجه، وما ينطبق على طفل قد لا ينطبق على آخر.
          </p>
        </div>

        <div class="disclaimer-block">
          <h2>2. إخلاء المسؤولية الطبي</h2>
          <div class="info-box">
            <p style="margin-bottom:0; font-weight:600;">
              موقع طيف الأمل ليس عيادة طبية، ولا يضم أطباء، ولا يقدم استشارات طبية،
              ولا يصف علاجات أو أدوية، ولا يُعطي تشخيصات.
            </p>
          </div>
          <p>
            لا ينبغي استخدام المعلومات الموجودة على هذا الموقع لما يلي:
          </p>
          <ul>
            <li>تشخيص طيف التوحد أو أي اضطراب نمائي آخر لطفلك</li>
            <li>اتخاذ قرارات طبية أو علاجية استناداً إلى محتوانا وحده</li>
            <li>تأخير أو إلغاء استشارة طبية متخصصة</li>
            <li>تعديل أو إيقاف أي علاج موصوف من قِبل طبيب</li>
            <li>تقييم مدى تقدم طفلك مقارنةً بمعايير الموقع</li>
          </ul>
          <p>
            إذا كان لديك قلق حول صحة طفلك النفسية أو النمائية، فإن الخطوة الصحيحة دائماً
            هي مراجعة طبيب أطفال أو طبيب نفسي متخصص في الاضطرابات النمائية أو فريق
            متعدد التخصصات في مركز متخصص معتمد.
          </p>
        </div>

        <div class="disclaimer-block">
          <h2>3. دقة المعلومات والتحديث</h2>
          <p>
            نسعى جاهدين في طيف الأمل للتحقق من صحة المعلومات التي ننشرها والاستناد إلى
            أحدث الأبحاث المتاحة. غير أن مجال اضطرابات النمو يشهد تطوراً علمياً مستمراً،
            وما كان صحيحاً في بحث نُشر قبل سنوات قد تُعدَّل توصياته اليوم.
          </p>
          <p>
            لذلك لا نضمن أن جميع المعلومات الواردة على الموقع هي الأحدث أو الأكثر اكتمالاً
            في أي وقت معين. يتحمل المستخدم مسؤولية التحقق من المعلومات مع متخصص قبل
            اتخاذ أي قرار يتعلق بصحة طفله أو تعليمه.
          </p>
          <p>
            إذا لاحظت أي معلومة تبدو قديمة أو غير دقيقة، يُرجى إبلاغنا عبر
            <a href="/contact/">صفحة التواصل</a>.
          </p>
        </div>

        <div class="disclaimer-block">
          <h2>4. إخلاء المسؤولية عن الأضرار</h2>
          <p>
            لن يكون موقع طيف الأمل أو القائمون عليه مسؤولين عن أي ضرر مباشر أو غير مباشر
            ينشأ عن:
          </p>
          <ul>
            <li>الاعتماد على معلومات منشورة على الموقع دون استشارة طبية</li>
            <li>تطبيق أساليب أو أدوات من الموقع دون إشراف متخصص</li>
            <li>أي انقطاع أو خطأ في خدمات الموقع</li>
            <li>محتوى المواقع الخارجية التي نُشير إليها</li>
          </ul>
          <p>
            استخدامك للموقع يعني موافقتك الكاملة على هذا الإخلاء من المسؤولية.
          </p>
        </div>

        <div class="disclaimer-block">
          <h2>5. المحتوى الخارجي والروابط</h2>
          <p>
            قد يحتوي موقع طيف الأمل على روابط لمواقع خارجية أو مصادر من أطراف ثالثة.
            هذه الروابط مُدرجة لتسهيل الرجوع إلى المصادر العلمية أو لتوجيهك لموارد
            إضافية مفيدة. لا نتحمل أي مسؤولية عن محتوى هذه المواقع الخارجية أو دقتها
            أو سياسات خصوصيتها.
          </p>
          <p>
            ذكر أي كتاب أو تطبيق أو منتج أو خدمة على موقعنا لا يُعدّ توصية رسمية أو
            ضماناً بجودته. المراجعات والتوصيات مبنية على تقييم تعليمي عام ولا تُغني عن
            الرأي المتخصص.
          </p>
        </div>

        <div class="disclaimer-block">
          <h2>6. حقوق الملكية الفكرية</h2>
          <p>
            جميع المحتويات الموجودة على موقع طيف الأمل — بما تشمل المقالات والأدوات
            والتصاميم والشعارات — محمية بموجب قوانين الملكية الفكرية.
          </p>
          <p>
            يُسمح بمشاركة روابط المقالات والاقتباس منها مع الإشارة الصريحة إلى المصدر.
            يُحظر إعادة نشر المحتوى كاملاً أو جزئياً على أي موقع آخر دون إذن كتابي مسبق.
          </p>
          <p>
            للاستفسار عن حقوق الاستخدام أو الترخيص، تواصل معنا عبر:
            <a href="/contact/">صفحة التواصل</a>
          </p>
        </div>

        <div class="disclaimer-block">
          <h2>7. حدود الخدمة الجغرافية</h2>
          <p>
            يخدم طيف الأمل الناطقين بالعربية في جميع أنحاء العالم. غير أن التشريعات
            والبروتوكولات الصحية تختلف من دولة إلى أخرى. المعلومات المتاحة على الموقع
            هي معلومات عامة وقد لا تنطبق على ظروف كل دولة أو كل نظام صحي.
          </p>
          <p>
            نوصيك بالتحقق من الإرشادات والبروتوكولات المعتمدة في بلدك مع المختصين
            المحليين المُرخَّصين.
          </p>
        </div>

        <div class="disclaimer-block">
          <h2>8. التواصل والتحديثات</h2>
          <p>
            قد نُعدَّل هذا الإخلاء من المسؤولية من وقت لآخر دون إشعار مسبق. تاريخ آخر
            تحديث مُدرج في أعلى هذه الصفحة. يُنصح بمراجعة هذه الصفحة بشكل دوري.
          </p>
          <p>
            إذا كان لديك أي سؤال حول هذا الإخلاء من المسؤولية أو حول محتوى الموقع،
            لا تتردد في التواصل معنا عبر <a href="/contact/">صفحة التواصل</a>.
          </p>
          <div class="info-box info-box--accent" style="margin-top: var(--space-md);">
            <h3>🌟 رسالة أخيرة</h3>
            <p style="margin-bottom:0;">
              نحن في طيف الأمل نؤمن بأن المعرفة أداة تمكين حقيقية. هدفنا أن تكون مُسلَّحاً
              بالمعلومات الصحيحة عندما تذهب لمقابلة الطبيب أو الأخصائي — لا أن تُغني هذه
              المعلومات عن تلك المقابلة. نحن شركاؤك في الفهم، والمتخصصون شركاؤك في العلاج.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Ad Slot Bottom -->
  <div class="container--narrow">
    <div class="ad-slot">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="1010101010"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>
  </div>

</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #1c2b2a 0%, #2d4a44 100%);
    color: #fff;
    padding: var(--space-xl) 0;
    text-align: center;
  }

  .page-hero .badge {
    background: rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.9);
  }

  .page-hero__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 900;
    color: #fff;
    margin: var(--space-xs) 0;
  }

  .page-hero__lead {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.82);
    max-width: 640px;
    margin: 0 auto var(--space-xs);
    line-height: 1.9;
  }

  .last-updated {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.5);
    font-family: var(--font-display);
  }

  .disclaimer-section {
    padding: var(--space-lg) 0 var(--space-xl);
  }

  /* Main Alert */
  .main-alert {
    display: flex;
    gap: var(--space-md);
    background: #fff3f3;
    border: 2px solid #e53e3e;
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .main-alert__icon {
    font-size: 2.5rem;
    flex-shrink: 0;
  }

  .main-alert__content h2 {
    font-size: 1.3rem;
    color: #c53030;
    margin-bottom: var(--space-xs);
  }

  .main-alert__content p {
    font-size: 0.97rem;
    line-height: 1.85;
    color: #742a2a;
    margin-bottom: 0.75rem;
  }

  /* Disclaimer Blocks */
  .disclaimer-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .disclaimer-block {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    box-shadow: var(--shadow-sm);
  }

  .disclaimer-block h2 {
    font-size: 1.2rem;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .disclaimer-block h3 {
    font-size: 1rem;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .disclaimer-block p {
    font-size: 0.97rem;
    line-height: 1.85;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .disclaimer-block p:last-child {
    margin-bottom: 0;
  }

  .disclaimer-block ul, .disclaimer-block ol {
    margin-bottom: var(--space-sm);
  }

  .disclaimer-block li {
    font-size: 0.97rem;
    color: var(--color-text-muted);
    margin-bottom: 0.4rem;
    line-height: 1.7;
  }

  .disclaimer-block a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .main-alert {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
