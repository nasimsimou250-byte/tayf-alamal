---
export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogImage = '/og-default.png',
} = Astro.props;

const siteName = 'طيف الأمل - دليل أولياء الأمور لتوحد الأطفال';
const fullTitle = `${title} | ${siteName}`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <!-- SEO Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ar_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Noto Kufi Arabic (display) + Noto Naskh Arabic (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;600;700;900&family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Global Styles -->
    <style is:global>
      :root {
        /* Color System */
        --color-primary: #1a6b5a;       /* Deep teal - trust, calm, nature */
        --color-primary-light: #2d8f78;
        --color-primary-xlight: #e8f5f1;
        --color-accent: #f4a233;        /* Warm amber - warmth, hope */
        --color-accent-light: #fef3e2;
        --color-text: #1c2b2a;
        --color-text-muted: #5a7068;
        --color-bg: #f7faf9;
        --color-surface: #ffffff;
        --color-border: #d0e4df;

        /* Typography */
        --font-display: 'Noto Kufi Arabic', sans-serif;
        --font-body: 'Noto Naskh Arabic', serif;

        /* Spacing rhythm (refined for balanced proportions) */
        --space-xs: 0.35rem;
        --space-sm: 0.75rem;
        --space-md: 1.25rem;
        --space-lg: 2rem;
        --space-xl: 3rem;
        --space-2xl: 4.25rem;

        /* Border radius */
        --radius-sm: 8px;
        --radius-md: 14px;
        --radius-lg: 20px;

        /* Shadows */
        --shadow-sm: 0 2px 8px rgba(26, 107, 90, 0.08);
        --shadow-md: 0 8px 24px rgba(26, 107, 90, 0.1);
        --shadow-lg: 0 16px 40px rgba(26, 107, 90, 0.12);
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        overflow-x: hidden;
      }

      body {
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.75;
        color: var(--color-text);
        background: var(--color-bg);
        direction: rtl;
        text-align: right;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        max-width: 100vw;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-display);
        font-weight: 700;
        line-height: 1.4;
        color: var(--color-text);
      }

      a {
        color: var(--color-primary);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      a:hover {
        color: var(--color-primary-light);
      }

      img {
        max-width: 100%;
        height: auto;
      }

      p {
        margin-bottom: var(--space-sm);
      }

      ul, ol {
        padding-right: var(--space-md);
      }

      /* Utility classes */
      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 var(--space-md);
      }

      .container--narrow {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 var(--space-md);
      }

      .section-title {
        font-size: clamp(1.35rem, 3.2vw, 1.85rem);
        font-weight: 800;
        margin-bottom: var(--space-sm);
        color: var(--color-primary);
      }

      .badge {
        display: inline-block;
        background: var(--color-accent-light);
        color: var(--color-accent);
        font-family: var(--font-display);
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0.2rem 0.7rem;
        border-radius: 100px;
        margin-bottom: var(--space-xs);
      }

      .btn {
        display: inline-block;
        padding: 0.75rem 1.75rem;
        border-radius: var(--radius-sm);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.95rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.22s ease;
        border: none;
        text-decoration: none;
      }

      .btn--primary {
        background: var(--color-primary);
        color: #fff;
        box-shadow: 0 4px 16px rgba(26, 107, 90, 0.28);
      }

      .btn--primary:hover {
        background: var(--color-primary-light);
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(26, 107, 90, 0.35);
      }

      .btn--outline {
        background: transparent;
        border: 2px solid var(--color-primary);
        color: var(--color-primary);
      }

      .btn--outline:hover {
        background: var(--color-primary);
        color: #fff;
      }

      /* Ad slot styles */
      .ad-slot {
        width: 100%;
        max-width: 100%;
        min-height: 90px;
        background: var(--color-primary-xlight);
        border: 1px dashed var(--color-border);
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: var(--space-lg) auto;
        text-align: center;
        font-family: var(--font-display);
        font-size: 0.75rem;
        color: var(--color-text-muted);
        overflow: hidden;
      }

      /* Article content styles */
      .article-body h2 {
        font-size: 1.35rem;
        color: var(--color-primary);
        margin-top: var(--space-lg);
        margin-bottom: var(--space-sm);
        padding-bottom: 0.4rem;
        border-bottom: 2px solid var(--color-border);
      }

      .article-body h3 {
        font-size: 1.15rem;
        margin-top: var(--space-md);
        margin-bottom: var(--space-xs);
      }

      .article-body ul, .article-body ol {
        margin-bottom: var(--space-sm);
      }

      .article-body li {
        margin-bottom: 0.4rem;
      }

      .article-body table,
      table {
        width: 100%;
        max-width: 100%;
        border-collapse: collapse;
        margin: var(--space-md) 0;
        font-size: 0.92rem;
        background: var(--color-surface);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        display: block;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      .article-body th {
        background: var(--color-primary);
        color: #fff;
        padding: 0.75rem 0.9rem;
        font-family: var(--font-display);
        font-weight: 700;
        text-align: right;
        white-space: nowrap;
      }

      .article-body td {
        padding: 0.7rem 0.9rem;
        border-bottom: 1px solid var(--color-border);
        text-align: right;
      }

      .article-body tr:last-child td {
        border-bottom: none;
      }

      .article-body tr:nth-child(even) td {
        background: var(--color-primary-xlight);
      }

      .info-box {
        background: var(--color-primary-xlight);
        border-right: 4px solid var(--color-primary);
        border-radius: var(--radius-sm);
        padding: var(--space-md);
        margin: var(--space-md) 0;
      }

      .info-box--accent {
        background: var(--color-accent-light);
        border-right: 4px solid var(--color-accent);
      }

      /* Responsive */
      @media (max-width: 768px) {
        :root {
          --space-sm: 0.65rem;
          --space-md: 1rem;
          --space-lg: 1.5rem;
          --space-xl: 2.25rem;
          --space-2xl: 3rem;
        }

        body {
          font-size: 0.95rem;
          line-height: 1.7;
        }

        .container {
          padding: 0 var(--space-sm);
        }

        .btn {
          padding: 0.7rem 1.4rem;
          font-size: 0.9rem;
        }

        .article-body h2 {
          font-size: 1.25rem;
        }

        .article-body h3 {
          font-size: 1.05rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Navigation -->
    <header class="site-header">
      <div class="container">
        <nav class="nav">
          <a href="/" class="nav__logo">
            <span class="nav__logo-icon">🌟</span>
            <span class="nav__logo-text">طيف الأمل</span>
          </a>
          <button class="nav__toggle" aria-label="القائمة" id="navToggle">
            <span></span><span></span><span></span>
          </button>
          <ul class="nav__links" id="navLinks">
            <li><a href="/">الرئيسية</a></li>
            <li><a href="/articles/">المقالات</a></li>
            <li><a href="/tools/">أدوات تعليمية</a></li>
            <li><a href="/games/">ألعاب أطفال 🎮</a></li>
            <li><a href="/about/">من نحن</a></li>
            <li><a href="/contact/">تواصل معنا</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <div class="footer-logo">🌟 طيف الأمل</div>
            <p>دليلك الموثوق لدعم طفلك في رحلة طيف التوحد — بمحتوى علمي مبسط باللغة العربية.</p>
          </div>
          <div class="footer-links">
            <h4>الأقسام</h4>
            <ul>
              <li><a href="/articles/">جميع المقالات</a></li>
              <li><a href="/tools/">الأدوات التعليمية</a></li>
              <li><a href="/games/">ألعاب تعليمية تفاعلية</a></li>
              <li><a href="/about/">من نحن</a></li>
              <li><a href="/contact/">تواصل معنا</a></li>
            </ul>
          </div>
          <div class="footer-links">
            <h4>مواضيع مهمة</h4>
            <ul>
              <li><a href="/articles/autism-levels-diagnosis/">مستويات التوحد والتشخيص</a></li>
              <li><a href="/articles/aba-therapy-home/">العلاج السلوكي في المنزل</a></li>
              <li><a href="/articles/visual-schedules-flashcards/">الجداول البصرية والبطاقات</a></li>
              <li><a href="/articles/social-stories/">القصص الاجتماعية</a></li>
              <li><a href="/articles/apps-books/">تطبيقات وكتب مُوصى بها</a></li>
              <li><a href="/articles/autism-faq/">أسئلة شائعة عن التوحد</a></li>
            </ul>
          </div>
          <div class="footer-links">
            <h4>قانوني</h4>
            <ul>
              <li><a href="/privacy-policy/">سياسة الخصوصية</a></li>
              <li><a href="/terms/">الشروط والأحكام</a></li>
              <li><a href="/disclaimer/">إخلاء المسؤولية</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} طيف الأمل. جميع الحقوق محفوظة.</p>
          <p class="footer-disclaimer">المحتوى على هذا الموقع لأغراض تعليمية فقط وليس بديلاً عن الاستشارة الطبية المتخصصة.</p>
        </div>
      </div>
    </footer>

    <style>
      /* Header & Nav */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-border);
        box-shadow: var(--shadow-sm);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 70px;
        gap: var(--space-md);
      }

      .nav__logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 1.35rem;
        color: var(--color-primary);
        text-decoration: none;
        white-space: nowrap;
      }

      .nav__logo-icon {
        font-size: 1.5rem;
      }

      .nav__links {
        display: flex;
        list-style: none;
        gap: var(--space-md);
        padding: 0;
        margin: 0;
      }

      .nav__links a {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--color-text-muted);
        text-decoration: none;
        padding: 0.25rem 0;
        border-bottom: 2px solid transparent;
        transition: all 0.2s ease;
      }

      .nav__links a:hover {
        color: var(--color-primary);
        border-bottom-color: var(--color-primary);
      }

      .nav__toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
      }

      .nav__toggle span {
        display: block;
        width: 24px;
        height: 2px;
        background: var(--color-primary);
        border-radius: 2px;
        transition: all 0.2s;
      }

      /* Footer */
      .site-footer {
        background: var(--color-text);
        color: rgba(255,255,255,0.75);
        padding: var(--space-xl) 0 var(--space-md);
        margin-top: var(--space-2xl);
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: var(--space-lg);
        margin-bottom: var(--space-lg);
      }

      .footer-logo {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 1.25rem;
        color: #fff;
        margin-bottom: var(--space-sm);
      }

      .footer-brand p {
        font-size: 0.9rem;
        line-height: 1.7;
      }

      .footer-links h4 {
        font-family: var(--font-display);
        font-weight: 700;
        color: #fff;
        margin-bottom: var(--space-sm);
        font-size: 1rem;
      }

      .footer-links ul {
        list-style: none;
        padding: 0;
      }

      .footer-links li {
        margin-bottom: 0.5rem;
      }

      .footer-links a {
        color: rgba(255,255,255,0.65);
        font-size: 0.9rem;
        text-decoration: none;
        transition: color 0.2s;
      }

      .footer-links a:hover {
        color: var(--color-accent);
      }

      .footer-bottom {
        border-top: 1px solid rgba(255,255,255,0.1);
        padding-top: var(--space-md);
        text-align: center;
        font-size: 0.85rem;
      }

      .footer-disclaimer {
        color: rgba(255,255,255,0.45);
        margin-top: 0.25rem;
        font-size: 0.8rem;
      }

      /* Responsive */
      @media (max-width: 900px) {
        .footer-grid {
          grid-template-columns: 1fr 1fr;
          gap: var(--space-md);
        }
      }

      @media (max-width: 820px) {
        .nav__links {
          display: none;
          position: absolute;
          top: 70px;
          right: 0;
          left: 0;
          background: #ffffff;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: 0.5rem 1.25rem 1rem;
          border-bottom: 2px solid var(--color-border);
          box-shadow: 0 12px 28px rgba(0,0,0,0.1);
          z-index: 999;
        }

        .nav__links.is-open {
          display: flex;
        }

        .nav__links li {
          border-bottom: 1px solid var(--color-primary-xlight);
        }

        .nav__links li:last-child {
          border-bottom: none;
        }

        .nav__links a {
          font-size: 1rem;
          padding: 0.85rem 0.5rem;
          display: block;
        }

        .nav__toggle {
          display: flex;
        }

        .site-footer {
          text-align: center;
        }

        .footer-grid {
          grid-template-columns: 1fr;
          gap: var(--space-lg);
          text-align: center;
        }

        .footer-brand {
          display: flex;
          flex-direction: column;
          align-items: center;
          text-align: center;
        }

        .footer-brand p {
          max-width: 440px;
          margin: 0 auto;
          text-align: center;
        }

        .footer-logo {
          text-align: center;
        }

        .footer-links {
          display: flex;
          flex-direction: column;
          align-items: center;
          text-align: center;
        }

        .footer-links h4 {
          text-align: center;
        }

        .footer-links ul {
          padding: 0;
          margin: 0;
          text-align: center;
          display: flex;
          flex-direction: column;
          align-items: center;
        }

        .footer-links li {
          text-align: center;
        }

        .footer-links a {
          display: inline-block;
          text-align: center;
        }

        .footer-bottom {
          text-align: center;
        }
      }
    </style>

    <script>
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      toggle?.addEventListener('click', () => {
        links?.classList.toggle('is-open');
      });
    </script>
  </body>
</html>
